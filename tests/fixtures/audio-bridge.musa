lfo = oscillator(sine, frequency: 0.5 Hz) |> scale(200 Hz);
modulate lfo -> reed.lowpass.cutoff;
assign oboe -> reed;
assign viola -> bow;
route oboe -> master;
route viola -> master;
send oboe -> hall at -18 dB;
send viola -> hall at -20 dB;
