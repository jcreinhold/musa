meter 4/4;
key c major;

performance {
profile reeds {
mark staccato { gate = 0.55; attack = 8 ms; }
mark accent { gate = 1; attack = 2 ms; }
dynamic p { amplitude = 0.25; }
dynamic f { amplitude = 0.8; }
}
profile strings {
mark staccato { gate = 0.7; attack = 15 ms; }
mark accent { gate = 1; attack = 5 ms; }
dynamic p { amplitude = 0.2; }
dynamic f { amplitude = 0.7; }
}
}

score {
part oboe {
profile reeds;
voice melody {
dynamic p;
crescendo to f { c5/4 staccato d5/4 e5/4 > f5/4 }
}
}
part viola {
profile strings;
voice countermelody {
dynamic f;
diminuendo to p { c4/4 > g3/4 a3/4 staccato f3/4 }
}
}
}

instrument reed conforms note_instrument {
implementation graph { oscillator(sine) |> lowpass(cutoff: 1800 Hz, resonance: 0.7) |> output; }
}
instrument bow conforms note_instrument {
implementation graph { oscillator(sine, ratio: 0.5) |> envelope(adsr(attack: 15 ms, release: 300 ms)) |> output; }
}

