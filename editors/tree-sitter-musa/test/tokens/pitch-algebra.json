    { "kind": "comment", "text": "// The torsor law, executable: the difference of two pitches is the" },
    { "kind": "comment", "text": "// interval that carries the first to the second, so acting by it lands on" },
    { "kind": "comment", "text": "// the second exactly." },
    { "kind": "fn", "text": "fn" },
