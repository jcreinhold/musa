  "tokens": [
    { "kind": "comment", "text": "// A chord class is content; a voicing is a realization of it. The two are" },
    { "kind": "comment", "text": "// separate types on purpose: `chord c major7` spells four pitch classes and" },
    { "kind": "comment", "text": "// chooses no register, no spacing, no doubling, and no bass. Nothing here" },
    { "kind": "comment", "text": "// derives notes from a chord symbol written above the staff, and nothing" },
    { "kind": "comment", "text": "// checks that separately authored notes agree with one." },
    { "kind": "comment", "text": "//" },
    { "kind": "comment", "text": "// One class, read two ways and sounded four." },
    { "kind": "piece", "text": "piece" },
    { "kind": "string", "text": "\"Chord Voicings\"" },
