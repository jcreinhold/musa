  "tokens": [
    { "kind": "comment", "text": "// Pitch-class sets and twelve-tone rows are an algebra over `pc12 = Z/12Z`," },
    { "kind": "comment", "text": "// and `pc12` is not a spelling. Every value below forgets which letter a note" },
    { "kind": "comment", "text": "// was written with; the only way back into notation is `spelled_in`, which" },
    { "kind": "comment", "text": "// takes the collection that decides the spelling and answers nothing where" },
    { "kind": "comment", "text": "// that collection has no such note." },
    { "kind": "comment", "text": "//" },
    { "kind": "comment", "text": "// The four row labels P, I, R, and RI are 24 affine operations on pitch" },
    { "kind": "comment", "text": "// classes times one reversal of order positions. That is `D12 x C2` and at" },
    { "kind": "comment", "text": "// most 48 labelled forms, not one 48-element group: `generic_forms` below is" },
    { "kind": "comment", "text": "// 48 and `chromatic_forms` is 24, and each one times its own stabilizer is 48." },
    { "kind": "piece", "text": "piece" },
    { "kind": "string", "text": "\"Serial Forms\"" },
