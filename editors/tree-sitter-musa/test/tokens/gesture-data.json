  "tokens": [
    { "kind": "comment", "text": "// A piece may declare its own finite data and fold over it. Nothing here is" },
    { "kind": "comment", "text": "// built in: `Gesture` is three constructors this file names, and" },
    { "kind": "comment", "text": "// `gesture_fold` is the structural fold written over them — a case per" },
    { "kind": "comment", "text": "// constructor, and the recursive fields already folded" },
    { "kind": "comment", "text": "// (docs/rules/language/02-core-calculus.md §1). The fold is source and not a" },
    { "kind": "comment", "text": "// declaration's by-product, because a generated name is one the reader cannot" },
    { "kind": "comment", "text": "// look up and one the author cannot document." },
    { "kind": "comment", "text": "//" },
    { "kind": "comment", "text": "// What it buys is that the *plan* is a value. A gesture can be built, passed," },
    { "kind": "comment", "text": "// and matched before any music exists, and the same plan reads two ways: as" },
    { "kind": "comment", "text": "// notation, by folding it into `EventTrack(WrittenTime)`, and as a count, by" },
    { "kind": "comment", "text": "// folding it into a number. An `EventTrack(WrittenTime) ->" },
    { "kind": "comment", "text": "// EventTrack(WrittenTime)` function could do neither." },
    { "kind": "piece", "text": "piece" },
    { "kind": "string", "text": "\"Gesture Study\"" },
    { "kind": "{", "text": "{" },
    { "kind": "meter", "text": "meter" },
    { "kind": "rational", "text": "4/4" },
    { "kind": ";", "text": ";" },
    { "kind": "comment", "text": "// The one gesture that is not made of others." },
