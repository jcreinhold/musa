  "tokens": [
    { "kind": "comment", "text": "// Diatonic sequences: a pattern, a count, and nothing else." },
    { "kind": "comment", "text": "//" },
    { "kind": "comment", "text": "// OMT `049-diatonic-sequences-in-middles.md` names sequences by the interval" },
    { "kind": "comment", "text": "// their roots move — descending fifths, descending thirds, ascending seconds —" },
    { "kind": "comment", "text": "// and every one of them is index arithmetic on scale degrees. So every one of" },
    { "kind": "comment", "text": "// them is an ordinary function in `std::tonal::sequences`: no sequence" },
    { "kind": "comment", "text": "// keyword, no generator, no recursion, and no rule about how long to go on." },
    { "kind": "comment", "text": "// The count is the caller's, which is why each pattern below is written twice" },
    { "kind": "comment", "text": "// at two lengths and neither is the library's opinion." },
    { "kind": "comment", "text": "//" },
    { "kind": "comment", "text": "// The same skeleton is voiced two ways, as in `rule-of-the-octave.musa`: close" },
    { "kind": "comment", "text": "// position in quarters, and drop-2 in halves. A chord class chooses no" },
    { "kind": "comment", "text": "// register, no spacing, and no rhythm, so it cannot be played until this file" },
    { "kind": "comment", "text": "// says how." },
    { "kind": "piece", "text": "piece" },
