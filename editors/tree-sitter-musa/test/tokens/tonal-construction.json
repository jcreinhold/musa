  "tokens": [
    { "kind": "comment", "text": "// Tonal harmony built rather than recognized." },
    { "kind": "comment", "text": "//" },
    { "kind": "comment", "text": "// Every chord below is constructed from a collection and a numeral, or from a" },
    { "kind": "comment", "text": "// collection and a named degree, and each one is voiced by a policy this piece" },
    { "kind": "comment", "text": "// writes down. Nothing here reads notes and reports a Roman numeral, decides" },
    { "kind": "comment", "text": "// that the passage has modulated, or picks a minor collection on the writer's" },
    { "kind": "comment", "text": "// behalf: `harmonic` and `parallel_minor` are named because C minor is three" },
    { "kind": "comment", "text": "// different collections and only the writer knows which one is meant." },
    { "kind": "comment", "text": "//" },
    { "kind": "comment", "text": "// The `option` on every line is the load-bearing part. `numeral_chord` is" },
    { "kind": "comment", "text": "// absent when a collection stacks to a sonority the chord vocabulary cannot" },
    { "kind": "comment", "text": "// name, and `close_position` is absent when the bass is not a member of the" },
    { "kind": "comment", "text": "// class *as spelled* — an F sharp bass under a German sixth exists and a G" },
    { "kind": "comment", "text": "// flat bass under it does not, which is the whole difference between the" },
    { "kind": "comment", "text": "// German sixth and the dominant seventh it sounds like." },
    { "kind": "piece", "text": "piece" },
    { "kind": "string", "text": "\"Tonal construction\"" },
