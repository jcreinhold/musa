// Performance intent: exact finite data between notation and instruments.
//
// Open Music Theory 007 separates written dynamics, articulation, and grouping
// from the instrument-dependent acts that realize them. OMT 114 makes the
// consequence concrete: a crescendo can change density, register, or forces,
// and therefore is not a disguised gain ramp. This module records the musical
// intention. Instruments in prompt 178 decide how to realize it.

import std::list;

// The value kind is an index, not a host tag inspected after checking.
data ControlKind {
    Normalized,
    PhraseConnection,
    ExactRatio,
}

data UpdateRate {
    PerNote,
    PerTransition,
    Continuous,
    PerGroup,
}

// A key states its index in the constructor result. At uses such as
// `Control(expression, NormalizedValue(1/2))`, the ordinary Miller-pattern
// unifier infers the one shared kind from both arguments.
data ControlKey: (kind: ControlKind) -> Type {
    Key(
        key_kind: ControlKind,
        namespace: Text,
        name: Text,
        summary: Text,
        update_rate: UpdateRate,
    ): ControlKey(key_kind),
}

data Connection {
    Detached,
    Ordinary,
    Legato,
}

data ControlValue: (kind: ControlKind) -> Type {
    NormalizedValue(value: Ratio): ControlValue(Normalized),
    ConnectionValue(connection: Connection): ControlValue(PhraseConnection),
    ExactRatioValue(value: Ratio): ControlValue(ExactRatio),
}

// Existential packaging retains the shared index while allowing unlike
// controls in one finite list. There is no dynamic host-side kind guess.
data SomeControl {
    Control(kind: ControlKind, control_key: ControlKey(kind), value: ControlValue(kind)),
}

// `kind` is intentionally omitted at call sites. It is solved only by
// unifying the two indexed arguments; a disagreement is a normal type error
// and an unresolved kind is never defaulted.
fn some_control(
    {kind: ControlKind},
    control_key: ControlKey(kind),
    value: ControlValue(kind),
) -> SomeControl { Control(kind, control_key, value) }

/// Sustained relative-intensity intention, independent of gain or velocity.
let expression: ControlKey(Normalized) = Key(
    Normalized,
    "std.performance",
    "expression",
    "Sustained relative intensity; not gain, velocity, or decibels.",
    Continuous,
);

/// Per-note attack-salience intention.
let emphasis: ControlKey(Normalized) = Key(
    Normalized,
    "std.performance",
    "emphasis",
    "Attack salience relative to neighbouring gestures.",
    PerNote,
);

/// Per-transition perceptual-detachment intention.
let separation: ControlKey(Normalized) = Key(
    Normalized,
    "std.performance",
    "separation",
    "Requested perceptual detachment; not a universal gate multiplier.",
    PerTransition,
);

/// Continuous relative spectral-brightness intention.
let brightness: ControlKey(Normalized) = Key(
    Normalized,
    "std.performance",
    "brightness",
    "Relative spectral-brightness intention; not filter cutoff.",
    Continuous,
);

/// Continuous continuation-after-release intention.
let sustain: ControlKey(Normalized) = Key(
    Normalized,
    "std.performance",
    "sustain",
    "Requested continuation after release; not pedal position or seconds.",
    Continuous,
);

/// Typed grouping relation among the gestures of a phrase.
let phrase_relation: ControlKey(PhraseConnection) = Key(
    PhraseConnection,
    "std.performance",
    "phrase",
    "A typed relation among gestures in one phrase group.",
    PerGroup,
);

/// Stable identity shared by a gesture and its separate host lineage entry.
record GestureId {
    value: Nat;
}

// A request remains symbolic even when an instrument also supplies a numeric
// fallback. Namespacing permits libraries to extend the vocabulary without a
// closed Rust enum.
record TechniqueRequest {
    namespace: Text;
    name: Text;
    arguments: List(Ratio);
}

data NonEmptyGestureIds {
    One(member: GestureId),
    More(member: GestureId, later: NonEmptyGestureIds),
}

data Gesture {
    NoteGesture(
        instance: GestureId,
        written_pitch: Pitch,
        controls: List(SomeControl),
        techniques: List(TechniqueRequest),
    ),
    ControlCurve(control_key: ControlKey(Normalized), values: Progress),
    PhraseGroup(members: NonEmptyGestureIds, connection: Connection),
    ReleaseGesture(instance: GestureId),
}

// A notation view contains every musical input visible to an ordinary profile
// call. It deliberately contains no host provenance, frame, primitive, or DSP
// address. The bridge supplies one value per written occurrence.
record HairpinView {
    target: Text;
    reached: Ratio;
}

/// Complete musical notation input presented to one profile call.
record NotationView {
    instance: GestureId;
    written_pitch: Pitch;
    dynamic_mark: Option(Text);
    marks: List(Text);
    hairpin: Option(HairpinView);
    connection: Option(Connection);
    techniques: List(TechniqueRequest);
}

/// One source-declared reading of a written dynamic marking.
record DynamicRule {
    name: Text;
    expression: Ratio;
}

/// One source-declared reading of a written articulation mark.
record MarkRule {
    name: Text;
    gate: Ratio;
    attack_seconds: Ratio;
    hold: Ratio;
    emphasis: Ratio;
    separation: Ratio;
    sustain: Ratio;
    techniques: List(TechniqueRequest);
}

/// Legacy surface timing declarations transcribed without host interpretation.
record LegacyMarkTiming {
    name: Text;
    gate: Ratio;
    attack_seconds: Ratio;
    hold: Ratio;
}

/// A finite, storable collection of source interpretation rules.
record PerformanceProfile {
    dynamics: List(DynamicRule);
    marks: List(MarkRule);
    controls: List(SomeControl);
    default_connection: Option(Connection);
}

/// Translate one compatibility timing declaration into source-owned intent.
private fn timing_rule(timing: LegacyMarkTiming) -> MarkRule {
    let written: TechniqueRequest = TechniqueRequest {
        namespace = "std.performance.written-mark",
        name = timing.name,
        arguments = []
    };
    if text_equal(timing.name, "staccato") {
        MarkRule {
            name = timing.name,
            gate = timing.gate,
            attack_seconds = timing.attack_seconds,
            hold = timing.hold,
            emphasis = 0/1,
            separation = 1/1,
            sustain = 0/1,
            techniques = [written]
        }
    } else if text_equal(timing.name, "accent") {
        MarkRule {
            name = timing.name,
            gate = timing.gate,
            attack_seconds = timing.attack_seconds,
            hold = timing.hold,
            emphasis = 1/1,
            separation = 0/1,
            sustain = 0/1,
            techniques = [written]
        }
    } else if text_equal(timing.name, "tenuto") {
        MarkRule {
            name = timing.name,
            gate = timing.gate,
            attack_seconds = timing.attack_seconds,
            hold = timing.hold,
            emphasis = 0/1,
            separation = 0/1,
            sustain = 1/1,
            techniques = [written]
        }
    } else {
        MarkRule {
            name = timing.name,
            gate = timing.gate,
            attack_seconds = timing.attack_seconds,
            hold = timing.hold,
            emphasis = 0/1,
            separation = 0/1,
            sustain = 0/1,
            techniques = [written]
        }
    }
}

/// Translate compatibility timing declarations in their written order.
private fn timing_rules(timings: List(LegacyMarkTiming)) -> List(MarkRule) {
    match timings {
        [] -> [],
        [timing, .. later] -> Cons(timing_rule(timing), timing_rules(later)),
    }
}

/// Build the compatibility surface profile as ordinary source policy.
fn profile_from_legacy(
    dynamics: List(DynamicRule),
    timings: List(LegacyMarkTiming),
) -> PerformanceProfile {
    PerformanceProfile {
        dynamics = dynamics,
        marks = timing_rules(timings),
        controls = [],
        default_connection = None
    }
}

/// Exact musical intent returned by one finite profile evaluation.
record ProfileResult {
    gesture: Gesture;
    gate: Ratio;
    hold: Ratio;
}

/// Temporary temporal compatibility fields kept outside gesture identity.
private record MarkTiming {
    gate: Ratio;
    attack_seconds: Ratio;
    hold: Ratio;
}

/// One finite request presented to the source interpreter by the host bridge.
record InterpretationRequest {
    policy: PerformanceProfile;
    view: NotationView;
}

/// Versioned checked results returned to the provenance/track bridge.
record PerformanceInterpretationArtifact {
    schema_version: Nat;
    results: List(ProfileResult);
}

/// Find a declared dynamic level, returning neutral expression when absent.
private fn dynamic_level(rules: List(DynamicRule), sought: Text) -> Ratio {
    match rules {
        [] -> 1/1,
        [rule, .. later] -> if text_equal(rule.name, sought) {
            rule.expression
        } else { dynamic_level(later, sought) },
    }
}

/// Collect the exact controls declared for the marks on one notation view.
private fn marked_controls(rules: List(MarkRule), marks: List(Text)) -> List(SomeControl) {
    match rules {
        [] -> [],
        [rule, .. later] -> if member_text(rule.name, marks) {
            Cons(
                some_control(emphasis, NormalizedValue(rule.emphasis)),
                Cons(
                    some_control(separation, NormalizedValue(rule.separation)),
                    Cons(
                        some_control(sustain, NormalizedValue(rule.sustain)),
                        marked_controls(later, marks),
                    ),
                ),
            )
        } else { marked_controls(later, marks) },
    }
}

/// Collect symbolic techniques without collapsing them into numeric controls.
private fn marked_techniques(rules: List(MarkRule), marks: List(Text)) -> List(
    TechniqueRequest,
) {
    match rules {
        [] -> [],
        [rule, .. later] -> if member_text(rule.name, marks) {
            concat(rule.techniques, marked_techniques(later, marks))
        } else { marked_techniques(later, marks) },
    }
}

/// Fold the legacy temporal projections declared by matching mark rules.
private fn mark_timing(
    rules: List(MarkRule),
    marks: List(Text),
    gate: Ratio,
    attack: Ratio,
    hold: Ratio,
) -> MarkTiming {
    match rules {
        [] -> MarkTiming {
            gate = gate,
            attack_seconds = attack,
            hold = hold
        },
        [rule, .. later] -> if member_text(rule.name, marks) {
            mark_timing(
                later,
                marks,
                ratio_mul(gate, rule.gate),
                rule.attack_seconds,
                ratio_mul(hold, rule.hold),
            )
        } else { mark_timing(later, marks, gate, attack, hold) },
    }
}

/// Whether one exact spelling occurs in a finite list.
private fn member_text(sought: Text, values: List(Text)) -> Bool {
    match values {
        [] -> false,
        [value, .. later] -> if text_equal(value, sought) {
            true
        } else { member_text(sought, later) },
    }
}

/// The prevailing expression level a profile gives one notation view.
private fn level_of(policy: PerformanceProfile, view: NotationView) -> Ratio {
    match view.dynamic_mark {
        None -> 1/1,
        Some(name) -> dynamic_level(policy.dynamics, name),
    }
}

/// Realize an explicit or profile-default phrase relation as one typed control.
private fn connection_controls(policy: PerformanceProfile, view: NotationView) -> List(
    SomeControl,
) {
    let selected: Option(Connection) = match view.connection {
        None -> policy.default_connection,
        Some(connection) -> Some(connection),
    };
    match selected {
        None -> [],
        Some(connection) -> [some_control(phrase_relation, ConnectionValue(connection))],
    }
}

// Exact affine interpolation for a hairpin sample. `reached` is the result of
// applying its source `Progress` at normalized local time; no sampling density
// or physical mapping is chosen here.
fn hairpin_expression(from: Ratio, target_level: Ratio, reached: Ratio) -> Ratio {
    ratio_add(from, ratio_mul(ratio_sub(target_level, from), reached))
}

/// Interpret one complete notation view as exact controls and techniques.
fn interpret(policy: PerformanceProfile, view: NotationView) -> ProfileResult {
    let prevailing = level_of(policy, view);
    let sounding: Ratio = match view.hairpin {
        None -> prevailing,
        Some(curve) -> hairpin_expression(
            prevailing,
            dynamic_level(policy.dynamics, curve.target),
            curve.reached,
        ),
    };
    let controls: List(SomeControl) = Cons(
        some_control(expression, NormalizedValue(sounding)),
        concat(
            marked_controls(policy.marks, view.marks),
            concat(connection_controls(policy, view), policy.controls),
        ),
    );
    let timing: MarkTiming = mark_timing(policy.marks, view.marks, 1/1, 0/1, 1/1);
    ProfileResult {
        gesture = NoteGesture(
            view.instance,
            view.written_pitch,
            controls,
            concat(view.techniques, marked_techniques(policy.marks, view.marks)),
        ),
        gate = timing.gate,
        hold = timing.hold
    }
}

/// Interpret a finite request list in source order.
fn interpret_all(requests: List(InterpretationRequest)) -> List(ProfileResult) {
    match requests {
        [] -> [],
        [request, .. later] -> Cons(
            interpret(request.policy, request.view),
            interpret_all(later),
        ),
    }
}

// The edition-pinned neutral policy is ordinary data. Its defaults retain
// symbolic intent: staccato requests separation, accent requests emphasis,
// tenuto requests sustain, and fermata remains a named technique rather than a
// host duration multiplier.
let neutral: PerformanceProfile = PerformanceProfile {
    // With no explicit profile, a written dynamic remains notation and the
    // signature default remains unchanged. Conventional level mappings are
    // policy, so `neutral` must not smuggle one in.
    dynamics = [],
    marks = [
        MarkRule {
            name = "staccato",
            gate = 1/1,
            attack_seconds = 0/1,
            hold = 1/1,
            emphasis = 0/1,
            separation = 1/1,
            sustain = 0/1,
            techniques = []
        },
        MarkRule {
            name = "accent",
            gate = 1/1,
            attack_seconds = 0/1,
            hold = 1/1,
            emphasis = 1/1,
            separation = 0/1,
            sustain = 0/1,
            techniques = []
        },
        MarkRule {
            name = "tenuto",
            gate = 1/1,
            attack_seconds = 0/1,
            hold = 1/1,
            emphasis = 0/1,
            separation = 0/1,
            sustain = 1/1,
            techniques = []
        },
        MarkRule {
            name = "fermata",
            gate = 1/1,
            attack_seconds = 0/1,
            hold = 1/1,
            emphasis = 0/1,
            separation = 0/1,
            sustain = 1/1,
            techniques = [
                TechniqueRequest {
                    namespace = "std.performance",
                    name = "fermata",
                    arguments = []
                },
            ]
        },
    ],
    controls = [],
    default_connection = None
};

/// Versioned finite root frozen by the generic checked-source boundary.
record PerformanceVocabularyArtifact {
    schema_version: Nat;
    standard_controls: List(SomeControl);
    neutral_profile: PerformanceProfile;
}

/// Edition-pinned standard controls and neutral profile for host/tooling consumers.
let performance_vocabulary: PerformanceVocabularyArtifact = PerformanceVocabularyArtifact {
    schema_version = 1,
    standard_controls = [
        some_control(expression, NormalizedValue(1/1)),
        some_control(emphasis, NormalizedValue(0/1)),
        some_control(separation, NormalizedValue(0/1)),
        some_control(brightness, NormalizedValue(1/2)),
        some_control(sustain, NormalizedValue(0/1)),
        some_control(phrase_relation, ConnectionValue(Ordinary)),
    ],
    neutral_profile = neutral
};
