library {
    // Open Music Theory `016-intervals.md` supplies the conventional generic/specific
    // interval names; `005-half-steps-whole-steps-and-accidentals.md` supplies
    // the spelling distinction retained by these values. The written unison
    // has no staff displacement and no chromatic displacement.
    let unison: Interval = P1;

    // The chromatic semitone spelled as a minor second.
    let minor_second: Interval = m2;

    // The diatonic tone spelled as a major second.
    let major_second: Interval = M2;

    // The perfect fourth.
    let perfect_fourth: Interval = P4;

    // The perfect fifth.
    let perfect_fifth: Interval = P5;

    // The written octave, which changes both coordinates by (7, 12).
    let octave: Interval = P8;

    // Apply two spelling-preserving written intervals in sequence.
    fn compose_intervals(first: Interval, second: Interval) -> Interval {
        interval_add(first, second)
    }

    // Reverse the direction of a written interval.
    fn inverse_interval(value: Interval) -> Interval { interval_inverse(value) }

    // Forget octave while retaining the written letter and accidental.
    fn written_pitch_class(value: Pitch) -> NoteName { pitchclass_of(value) }

    // What `p up M3` and `p down M3` mean, for the two things that can be
    // written on either side of them.
    //
    // One operator over two domains, because it is one action: a written
    // interval moves the letter by its generic size and lets the accidental
    // absorb the rest, and whether an octave is carried along changes nothing
    // about that. What the two domains do not share is the answer — a `Pitch`
    // stays a `Pitch` and a `NoteName` stays a `NoteName` — so the receiver
    // decides which operation runs, which is what a trait is for.
    //
    // `down` is not a second method. It is the interval that undoes this one,
    // and `inverse_interval` above already names it.
    trait Transposable<A> {
        fn transposed(subject: A, by: Interval) -> A;
    }

    // A written pitch moved by a written interval. Partial: the pitch grid is
    // finite in both coordinates, so a transposition can leave it, and what
    // leaves it is refused rather than wrapped.
    impl Transposable<Pitch> {
        fn transposed(subject: Pitch, by: Interval) -> Pitch { pitch_transposed(subject, by) }
    }

    // The same move with the octave forgotten. Partial for the other
    // coordinate: the spelled classes run out of accidentals before they run
    // out of letters.
    impl Transposable<NoteName> {
        fn transposed(subject: NoteName, by: Interval) -> NoteName {
            pitchclass_transposed(subject, by)
        }
    }

}
