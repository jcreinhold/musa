library {

    // Twelve-tone rows and the operations on them (OMT
    // `108-basics-of-twelve-tone-theory.md`,
    // `109-naming-conventions-for-rows.md`, `110-row-properties.md`).
    //
    // A row is a bijection from the twelve order positions onto the twelve
    // pitch classes. An arbitrary sequence of pitch classes is a
    // `list[pc12]` and stays one: `row` is the only way in, and it answers
    // nothing when the sequence is not a row. Because the invariant is
    // checked once there, every operation below is total — composing a row
    // with a permutation of order positions and a bijection of pitch
    // classes is again a row, so none of them can fail.
    //
    // The four labels P, I, R, and RI are 24 affine pitch-class operations
    // times the reversal R, which is a separate involution acting on order
    // positions. That is `D12 x C2`, so there are at most 48 labelled forms
    // — not one 48-element group of pitch-class operations. How many
    // distinct rows those 48 labels produce depends on the row, so
    // `distinct_forms` counts rather than assumes.

    // The row a sequence spells, or nothing when the sequence is not one.
    fn row(pcs: List<Pc12>) -> Option<Row12> { row12_of(pcs) }

    // The order positions whose pitch class already appeared earlier — the
    // exact reason a sequence failed to be a row. The first occurrence is
    // not among them, because that is where the pitch class belongs.
    fn repeated_positions(pcs: List<Pc12>) -> List<Nat> { row12_repeats(pcs) }

    // The pitch classes a sequence never names, ascending — the other exact
    // reason. A sequence of the right length has one of these lists empty
    // exactly when it has the other empty.
    fn missing_classes(pcs: List<Pc12>) -> List<Pc12> { row12_missing(pcs) }

    // The row's pitch classes, in order position order.
    fn pcs_of(series: Row12) -> List<Pc12> { row12_pcs(series) }

    // P: transposition by n semitones, order positions untouched.
    fn transposed(series: Row12, index: Nat) -> Row12 { row12_transposed(series, index) }

    // I: inversion about n, order positions untouched.
    fn inverted(series: Row12, index: Nat) -> Row12 { row12_inverted(series, index) }

    // R: the order positions reversed, pitch classes untouched. An
    // involution, and it commutes with P and I because it acts on the other
    // side of the row.
    fn retrograde_of(series: Row12) -> Row12 { row12_retrograde(series) }

    // RI: the retrograde of the inversion, which is also the inversion of
    // the retrograde. Writing it both ways and getting one row is what
    // "commutes" means here.
    fn retrograde_inversion_of(series: Row12, index: Nat) -> Row12 {
        row12_retrograde(row12_inverted(series, index))
    }

    // The twelve-tone matrix, as twelve rows. Row zero is the row as
    // written; row i is the transposition beginning on the ith pitch class
    // of the inversion about the row's own head, so every column read
    // downward is an inversion. The construction fixes no naming convention,
    // because the rows are rows and not labels: which transposition is
    // called P0 is the question the two functions below answer, differently
    // and by name.
    fn matrix(series: Row12) -> List<Row12> { row12_matrix(series) }

    // The transposition index under the fixed-zero convention: P0 is the
    // form beginning on pitch class zero, so a row's index is simply the
    // number of the pitch class it begins on.
    fn fixed_zero_index(series: Row12) -> Nat { pc12_number(first_pc(series)) }

    // The transposition index under the moveable-zero convention: P0 is the
    // row as written, so an index is only meaningful relative to a stated
    // reference row. `moveable_zero_index(reference, form)` is how far the
    // form stands above the reference.
    fn moveable_zero_index(reference: Row12, form: Row12) -> Nat {
        pc12_number(pc12_inverted(first_pc(reference), pc12_number(first_pc(form))))
    }

    // How many *distinct* rows the 48 labelled forms produce. Forty-eight
    // for a generic row; fewer for a row some labelled operation fixes.
    fn distinct_forms(series: Row12) -> Nat { row12_forms(series) }

    // The order of the row's stabilizer: how many of the 48 labelled
    // operations send the row to itself. This times `distinct_forms` is
    // always 48, which is the orbit-stabilizer accounting the four labels
    // are so often asked to do on their own.
    fn symmetries(series: Row12) -> Nat { row12_symmetries(series) }

    // Spell one row inside a collection, position by position. A pitch class
    // the collection cannot spell is absent, and the row keeps its length,
    // so a projection that lost notes is visible as the gaps it left.
    fn row_spelled_in(series: Row12, collection: Scale) -> List<Option<NoteName>> {
        map(spelling_in(collection), row12_pcs(series))
    }

    // The spelling policy of one collection, as a function a row can be
    // carried across.
    fn spelling_in(collection: Scale, member: Pc12) -> Option<NoteName> {
        pc12_spelled(member, collection)
    }

    // The pitch class a row begins on. Order position zero always exists,
    // because a row has twelve of them.
    fn first_pc(series: Row12) -> Pc12 { row12_head(series) }
}
