library {
    import std::scale;
    import std::voicing;

    // A tonal context is the small bundle of facts that always travel
    // together: what key a passage is in, which collection it steps through,
    // how a numbered degree is spelled in register, and how a chord class is
    // voiced. Passing them one at a time is how they drift apart, which is
    // the whole reason a signature exists — Open Music Theory
    // `105-diatonic-modes.md` names the collection, `017-triads.md` the
    // chords, and neither is meaningful without the other.
    signature TonalContext {
        // The key the passage is written in. A key is a signature and a
        // tonic, never a scale.
        let tonic: Key;

        // The collection stepwise motion reads. A default, not a claim: a
        // passage may still name another collection where it wants one.
        let collection: Scale;

        // The written pitch a numbered degree names, in this context's own
        // register. Absent when the context has no register to spell in.
        let spell: Nat -> Option<Pitch>;

        // How this context voices a chord class. Absent when the class
        // cannot be voiced from the register it chose.
        let voicing_for: ChordClass -> Option<Voicing>;
    }

    // C major, spelled from middle C.
    structure CMajor: TonalContext {
        let tonic: Key = key c major;
        let collection: Scale = scale c ionian;

        // The register degrees are spelled in. Private: a context promises
        // spelled pitches, not the frame it spells them from, so changing
        // where this one sits changes nothing anyone outside can name.
        let home: Option<Frame> = frame_on(collection, c4);

        fn spell(ordinal: Nat) -> Option<Pitch> {
            match home {
                None -> None,
                Some(register) -> Some(frame_degree(register, ordinal)),
            }
        }

        fn voicing_for(content: ChordClass) -> Option<Voicing> { close_position(content, c4) }
    }

    // A natural minor, spelled from the A below middle C. The same four
    // members, answered differently — which is what makes the two structures
    // interchangeable everywhere `TonalContext` is asked for.
    structure ANaturalMinor: TonalContext {
        let tonic: Key = key a minor;
        let collection: Scale = scale a aeolian;

        let home: Option<Frame> = frame_on(collection, a3);

        fn spell(ordinal: Nat) -> Option<Pitch> {
            match home {
                None -> None,
                Some(register) -> Some(frame_degree(register, ordinal)),
            }
        }

        fn voicing_for(content: ChordClass) -> Option<Voicing> { close_position(content, a3) }
    }
}
