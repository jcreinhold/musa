import std::sound::quantity;

// The edition-pinned vocabulary a musician, editor, and compiler share.
//
// These are declarations and finite data, not running processors. Native
// state, configuration layouts, resource accounting, and stepping remain in
// the host primitive registry. Prompt 178 adds the ordinary source wrappers
// that construct machines from the registrations named here.

/// What kind of public signal a processor produces or transforms.
data SignalRole {
    AudioProcessor,
    ControlProcessor,
    AudioOrControlSource,
}

/// A source-facing signal port kind, independent of private graph indices.
data SurfacePort {
    Audio,
    Control,
    NoteEvents,
}

/// One valid first-order input and result shape for a processor.
record PortContract {
    inputs: List(SurfacePort);
    result: SurfacePort;
}

// A source parameter's three quantities necessarily share one dimension.
// The ordinary Miller-pattern unifier solves that index while each contract
// is checked; there is no sound-specific unit inference path.
/// One exact parameter contract indexed by the dimension all its values share.
data ParameterContract: (dimension: SoundDimension) -> Type {
    ParameterFields(
        contract_dimension: SoundDimension,
        name: Text,
        summary: Text,
        default: SoundQuantity(contract_dimension),
        minimum: SoundQuantity(contract_dimension),
        maximum: SoundQuantity(contract_dimension),
    ): ParameterContract(contract_dimension),
}

// Existential packaging keeps differently dimensioned parameters in one
// finite declaration list while retaining the checked index internally.
/// An existential package for one dimension-indexed parameter contract.
data SomeParameterContract {
    SomeParameter(dimension: SoundDimension, contract: ParameterContract(dimension)),
}

// Stable host capability required by a future executable source wrapper.
// This names no state layout or work figure: those remain private host facts.
record PrimitiveRequirement {
    id: Text;
    version: Nat;
}

/// One complete source-facing standard processor declaration.
record ProcessorContract {
    name: Text;
    summary: Text;
    details: Text;
    signature: Text;
    role: SignalRole;
    ports: List(PortContract);
    example: Text;
    parameters: List(SomeParameterContract);
    primitives: List(PrimitiveRequirement);
}

/// Documentation and written shape for one standard studio term.
record StudioTermContract {
    spelling: Text;
    summary: Text;
    signature: Text;
    details: Text;
    example: Text;
}

/// The edition-pinned finite studio vocabulary crossing the checked boundary.
record StudioVocabularyArtifact {
    schema_version: Nat;
    processors: List(ProcessorContract);
    terms: List(StudioTermContract);
}

/// Construct an exact frequency quantity for a catalogue declaration.
private fn frequency_value(value: Ratio) -> SoundQuantity(Frequency) {
    Written(Frequency, value, Hertz)
}

/// Construct an exact linear-amplitude quantity for a catalogue declaration.
private fn linear_value(value: Ratio) -> SoundQuantity(LinearAmplitude) {
    Written(LinearAmplitude, value, Linear)
}

/// Construct an exact level quantity for a catalogue declaration.
private fn level_value(value: Ratio) -> SoundQuantity(Level) { Written(Level, value, Decibels) }

/// Construct an exact time quantity for a catalogue declaration.
private fn time_value(value: Ratio) -> SoundQuantity(Time) { Written(Time, value, Seconds) }

/// Package a frequency parameter while retaining its checked index.
private fn frequency_parameter(
    name: Text,
    summary: Text,
    default: Ratio,
    minimum: Ratio,
    maximum: Ratio,
) -> SomeParameterContract {
    SomeParameter(
        Frequency,
        ParameterFields(
            Frequency,
            name,
            summary,
            frequency_value(default),
            frequency_value(minimum),
            frequency_value(maximum),
        ),
    )
}

/// Package a linear-amplitude parameter while retaining its checked index.
private fn linear_parameter(
    name: Text,
    summary: Text,
    default: Ratio,
    minimum: Ratio,
    maximum: Ratio,
) -> SomeParameterContract {
    SomeParameter(
        LinearAmplitude,
        ParameterFields(
            LinearAmplitude,
            name,
            summary,
            linear_value(default),
            linear_value(minimum),
            linear_value(maximum),
        ),
    )
}

/// Package a level parameter while retaining its checked index.
private fn level_parameter(
    name: Text,
    summary: Text,
    default: Ratio,
    minimum: Ratio,
    maximum: Ratio,
) -> SomeParameterContract {
    SomeParameter(
        Level,
        ParameterFields(
            Level,
            name,
            summary,
            level_value(default),
            level_value(minimum),
            level_value(maximum),
        ),
    )
}

/// Package a time parameter while retaining its checked index.
private fn time_parameter(
    name: Text,
    summary: Text,
    default: Ratio,
    minimum: Ratio,
    maximum: Ratio,
) -> SomeParameterContract {
    SomeParameter(
        Time,
        ParameterFields(
            Time,
            name,
            summary,
            time_value(default),
            time_value(minimum),
            time_value(maximum),
        ),
    )
}

/// Name one version-one host capability without exposing its implementation.
private fn primitive(id: Text) -> PrimitiveRequirement {
    PrimitiveRequirement {
        id = id,
        version = 1
    }
}

/// The public shape shared by unary audio processors.
private let audio_processor_ports: List(PortContract) = [
    PortContract {
        inputs = [Audio],
        result = Audio
    },
];

/// The public shape shared by unary control processors.
private let control_processor_ports: List(PortContract) = [
    PortContract {
        inputs = [Control],
        result = Control
    },
];

/// The two context-selected public shapes of an oscillator.
private let oscillator_ports: List(PortContract) = [
    PortContract {
        inputs = [NoteEvents],
        result = Audio
    },
    PortContract {
        inputs = [],
        result = Control
    },
];

