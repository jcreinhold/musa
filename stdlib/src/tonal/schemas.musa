library {
    import std::harmony;
    import std::scale;

    // A galant schema is a short prototype: a bass line, a melody above it,
    // and a metrical shape, each a fixed number of stages long. OMT
    // `033-galant-schemas.md` and `034-galant-schemas-summary.md` set them out
    // as tables, and a table of a fixed width is a list — so every schema here
    // is a list literal, written once, with no keyword, no generator, and no
    // recursion. The Rule of the Octave below is the one thing in this file
    // that is computed rather than tabulated, because OMT 35 states it as a
    // recipe rather than a table.
    //
    // What a schema is here: scale *degrees*. Not pitches, not chords, not
    // music. A degree is a coordinate, so the same Romanesca is written once
    // and read in any key and any collection, and nothing chooses a register
    // until a caller does.
    //
    // What a schema is not: a claim about a passage. OMT 33 introduces these
    // as prototypes a listener may recognize, and a prototype that matches is
    // not a passage's meaning. Nothing in this file analyzes; everything
    // constructs. A composer who writes a Prinner has written one, and a
    // passage that resembles one has not thereby been explained.
    //
    // Each schema comes in three parallel lists — bass, melody, and the root
    // the stage's harmony is built on — plus the metrical weights OMT prints
    // as S and W. They are parallel by construction: each schema's lists are
    // written in one place, to one width, from one OMT table. Splitting them
    // rather than returning one list of bundles is deliberate: a caller almost
    // always wants one line at a time, and the language has no product to
    // bundle them into that would not also have to be taken apart again.

    // The contract every schema table below shares, stated once rather than
    // thirty-five times, because it is the same contract every time and a
    // reader who has to check whether it changed is a reader who will not:
    //
    //   Input domain: none. A schema is a fixed table, not a function of a key
    //     or a collection — that is what makes it a prototype.
    //   Output shape: a list of degrees, one per stage, in OMT's own order,
    //     with the same length as that schema's other lists.
    //   Direction: whatever OMT's row does, named per schema below. A schema
    //     is not its intervals reversed, so no function here has a direction
    //     parameter.
    //   Scale and key assumption: a diatonic collection with seven degrees to
    //     the period. Nothing chooses a key, a register, or a tonic.
    //   Inversion and voice-leading policy: none. The `..._roots` lists read
    //     OMT's figures far enough to say what each stage is rooted on, and
    //     stop there. Which note sounds lowest, how the parts move between
    //     stages, and whether anything is doubled are all a caller's.
    //   Not guaranteed: that a passage matching a table is an instance of the
    //     schema. These construct; nothing here analyzes.
    //
    // Where a function departs from this — an altered degree, a variant of a
    // different length — it says so where it stands.

    // ---- Reading the tables -------------------------------------------------

    // The degrees of a written line, from the ordinals OMT prints. Written out
    // rather than folded because a schema *is* its table: a reader should see
    // the same numbers here that they see in OMT's row.
    fn degrees_of(ordinals: List<Nat>) -> List<Degree> { map(as_degree, ordinals) }

    // One ordinal as a degree. Written out because `degree_of` is a
    // compiler-owned operation and only a source function can be passed to a
    // fold.
    fn as_degree(ordinal: Nat) -> Degree { degree_of(ordinal) }

    // ---- Opening gambits ----------------------------------------------------

    // Romanesca, OMT 34 §Romanesca. Four stages, strong-weak-strong-weak,
    // figures 5-6-5-6. The bass falls *do-ti-la-mi*: three steps down and then
    // a leap, which is what distinguishes it from the stepwise openings.
    //
    // Direction: descending, then a leap down to the third.
    fn romanesca_bass() -> List<Degree> { degrees_of([1, 7, 6, 3]) }

    // The Romanesca melody, *do-sol-do-do*.
    fn romanesca_melody() -> List<Degree> { degrees_of([1, 5, 1, 1]) }

    // The roots the Romanesca's figures name: I-V-vi-I. The 6 on stage two
    // means the chord over *ti* is rooted on *sol*, and the 6 on stage four
    // means the chord over *mi* is rooted on *do*. The figure is read here so
    // that a caller reads roots, and the bass is kept separately so that the
    // caller can still voice from it.
    fn romanesca_roots() -> List<Degree> { degrees_of([1, 5, 6, 1]) }

    // The Romanesca's metrical shape. True is OMT's S.
    fn romanesca_strong() -> List<Bool> { [true, false, true, false] }

    // Do-Re-Mi, OMT 34 §Do–Re–Mi. Three stages, the shortest opening in the
    // summary table, and the one whose two halves OMT itself calls schemas:
    // the Do-Re question and the Re-Mi answer. Figures 5-6-5, numerals I-V-I.
    fn do_re_mi_bass() -> List<Degree> { degrees_of([1, 7, 1]) }

    // The Do-Re-Mi melody, which is the stepwise ascent the schema is named
    // for.
    fn do_re_mi_melody() -> List<Degree> { degrees_of([1, 2, 3]) }

    // The Do-Re-Mi roots: I-V-I, the 6 on stage two rooting the chord over
    // *ti* on *sol*.
    fn do_re_mi_roots() -> List<Degree> { degrees_of([1, 5, 1]) }

    // The Do-Re-Mi's metrical shape, strong-weak-strong: the shortest of the
    // openings leans on its outer stages.
    fn do_re_mi_strong() -> List<Bool> { [true, false, true] }

    // ---- Answer, process, transition ---------------------------------------

    // Prinner, OMT 34 §Prinner. Four stages with a stepwise falling bass
    // *fa-mi-re-do* under a falling *la-sol-fa-mi*: parallel tenths, which is
    // why it answers an opening so readily. Figures 5-6-7-6-5, numerals
    // IV-I-vii-I.
    fn prinner_bass() -> List<Degree> { degrees_of([4, 3, 2, 1]) }

    // The Prinner melody, *la-sol-fa-mi*. It falls a tenth above the falling
    // bass at every stage, which is the parallel motion the schema is heard by.
    fn prinner_melody() -> List<Degree> { degrees_of([6, 5, 4, 3]) }

    // The Prinner's roots. Stage two's 6 roots the chord over *mi* on *do*,
    // and stage four's 6 does the same over *do*, which is why the last two
    // roots are not the bass.
    fn prinner_roots() -> List<Degree> { degrees_of([4, 1, 7, 1]) }

    // The Prinner's metrical shape, strong-weak-strong-weak.
    fn prinner_strong() -> List<Bool> { [true, false, true, false] }

    // The five-stage Prinner OMT 34 gives as "a slight variant on this": a
    // root-position dominant is inserted before the final stage. A separate
    // function rather than a flag, because a variant with a different number
    // of stages is a different table and a caller reading four lists in
    // parallel should not have one of them silently change length.
    fn prinner_with_dominant_bass() -> List<Degree> { degrees_of([4, 3, 2, 5, 1]) }

    // The five-stage Prinner's melody: the four-stage line with *fa* held
    // across the inserted dominant rather than falling through it.
    fn prinner_with_dominant_melody() -> List<Degree> { degrees_of([6, 5, 4, 4, 3]) }

    // The five-stage Prinner's roots. The four-stage roots with the inserted
    // stage rooted on the fifth degree, which is what makes it a dominant.
    fn prinner_with_dominant_roots() -> List<Degree> { degrees_of([4, 1, 7, 5, 1]) }

    // The five-stage Prinner's metrical shape. One stage longer than the
    // four-stage Prinner's, and strong at the end rather than weak.
    fn prinner_with_dominant_strong() -> List<Bool> { [true, false, true, false, true] }

    // Fonte, OMT 34 §Fonte. Two tonicizations a step apart, and the first of
    // them needs a bass note the collection does not contain: OMT writes it
    // *di*, a raised *do*. This is the schema that proves an alteration has to
    // be carried explicitly — `raise` moves the spelling without moving the
    // coordinate, so the degree is still the first and is still spelled sharp.
    fn fonte_bass() -> List<Degree> {
        [raise(degree_of(1)), degree_of(2), degree_of(7), degree_of(1)]
    }

    // The Fonte melody, *sol-fa-fa-mi*: the fourth degree is held across the
    // step down, so only the bass and the harmony move between the two
    // tonicizations.
    fn fonte_melody() -> List<Degree> { degrees_of([5, 4, 4, 3]) }

    // The Fonte's roots: V/ii-ii-V-I. The applied dominant is rooted on the
    // raised first degree because that is the note OMT's figure sits over, and
    // the raising travels with the root.
    fn fonte_roots() -> List<Degree> {
        [raise(degree_of(1)), degree_of(2), degree_of(5), degree_of(1)]
    }

    // The Fonte's metrical shape, weak-strong-weak-strong: each of the two
    // tonicizations leans on its second stage.
    fn fonte_strong() -> List<Bool> { [false, true, false, true] }

    // Monte, OMT 34 §Monte. The Fonte's counterpart, rising rather than
    // falling, and altered in the other direction: OMT writes *fi*, a raised
    // *fa*, tonicizing the dominant. Figures 6/5-5-6/5-5, numerals
    // V/IV-V-V/V-V.
    fn monte_bass() -> List<Degree> {
        [degree_of(3), degree_of(4), raise(degree_of(4)), degree_of(5)]
    }

    // The Monte melody, *ti-la-do-ti*, rising to the octave over the second
    // tonicization where the Fonte's line fell.
    fn monte_melody() -> List<Degree> { degrees_of([7, 6, 1, 7]) }

    // The Monte's roots, the numerals above read as degrees. The third stage
    // is rooted on a raised degree because its chord is an applied dominant,
    // and the raising travels with the root as it does in the Fonte.
    fn monte_roots() -> List<Degree> {
        [degree_of(1), degree_of(5), raise(degree_of(2)), degree_of(5)]
    }

    // The Monte's metrical shape, weak-strong-weak-strong: the same lean as
    // the Fonte's, which is what makes the two a rising and a falling pair.
    fn monte_strong() -> List<Bool> { [false, true, false, true] }

    // ---- Pre-cadential ------------------------------------------------------

    // Fenaroli, OMT 34 §Fenaroli. The one representative here whose bass
    // *rises* stepwise, *ti-do-re-mi*, which is why it is in this file beside
    // the falling ones: a schema is not its intervals reversed.
    fn fenaroli_bass() -> List<Degree> { degrees_of([7, 1, 2, 3]) }

    // The Fenaroli melody, *fa-mi-ti-do*: a falling step, and then the leading
    // tone resolving upward to the tonic.
    fn fenaroli_melody() -> List<Degree> { degrees_of([4, 3, 7, 1]) }

    // The Fenaroli's roots: V-I-V-I, with the 6 on the last stage rooting the
    // chord over *mi* on *do*.
    fn fenaroli_roots() -> List<Degree> { degrees_of([5, 1, 5, 1]) }

    // The Fenaroli's metrical shape, strong-weak-strong-weak.
    fn fenaroli_strong() -> List<Bool> { [true, false, true, false] }

    // ---- Cadence and post-cadential ----------------------------------------

    // Cadenza semplice, OMT 34 §Cadenza Semplice. The plain cadence: bass
    // *mi-fa-sol-do*, figures 6-6/5-5-5, numerals I-ii-V-I.
    fn cadenza_semplice_bass() -> List<Degree> { degrees_of([3, 4, 5, 1]) }

    // The plain cadence's melody, *do-re-re-do*: the second degree held across
    // the pre-dominant and the dominant, and falling to the tonic at the end.
    fn cadenza_semplice_melody() -> List<Degree> { degrees_of([1, 2, 2, 1]) }

    // The plain cadence's roots, I-ii-V-I. The 6 on stage one roots the chord
    // over *mi* on *do*, and the 6/5 on stage two roots the chord over *fa*
    // on *re*, so neither of the first two roots is its bass.
    fn cadenza_semplice_roots() -> List<Degree> { degrees_of([1, 2, 5, 1]) }

    // The plain cadence's metrical shape, weak-strong-weak-strong, so the
    // cadence itself lands on a strong stage.
    fn cadenza_semplice_strong() -> List<Bool> { [false, true, false, true] }

    // Quiescenza, OMT 34 §Quiescenza. Post-cadential, and the one schema here
    // whose bass does not move at all: four stages on *do*. Its melody needs
    // the other alteration — OMT writes *te*, a lowered *ti* — which makes the
    // first chord a dominant of the subdominant over a tonic pedal.
    fn quiescenza_bass() -> List<Degree> { degrees_of([1, 1, 1, 1]) }

    // The Quiescenza melody, *te-la-ti-do*. The lowered seventh is what makes
    // the first chord a dominant of the subdominant; the rest is the ordinary
    // ascent to the tonic over the held bass.
    fn quiescenza_melody() -> List<Degree> {
        [lower(degree_of(7)), degree_of(6), degree_of(7), degree_of(1)]
    }

    // The Quiescenza's roots, I-V-V-I, sounding above the tonic its bass holds
    // through all four stages.
    fn quiescenza_roots() -> List<Degree> { degrees_of([1, 5, 5, 1]) }

    // The Quiescenza's metrical shape, weak-strong-weak-strong.
    fn quiescenza_strong() -> List<Bool> { [false, true, false, true] }

    // ---- Harmonizing a schema ----------------------------------------------

    // The chord classes a schema's roots name in one collection, as triads.
    // Absent where the collection does not stack to a nameable sonority, and
    // absent on an altered root, because an applied dominant is not the
    // collection's own chord and this function only knows the collection's.
    // That absence is the honest answer: `fonte_roots` and `monte_roots` carry
    // raised degrees on purpose, and a caller who wants those chords supplies
    // them, from `std::tonal::harmony`, where applied chords live.
    fn schema_triads(collection: Scale, roots: List<Degree>) -> List<Option<ChordClass>> {
        map(schema_triad(collection), roots)
    }

    // One root, harmonized as the collection's triad.
    fn schema_triad(collection: Scale, root: Degree) -> Option<ChordClass> {
        degree_chord(collection, root, 3)
    }

    // The same as seventh chords, for the figures OMT prints with a 7 or a
    // 6/5 in them.
    fn schema_sevenths(collection: Scale, roots: List<Degree>) -> List<Option<ChordClass>> {
        map(schema_seventh(collection), roots)
    }

    // One root, harmonized as the collection's seventh chord.
    fn schema_seventh(collection: Scale, root: Degree) -> Option<ChordClass> {
        degree_chord(collection, root, 4)
    }

    // ---- The Rule of the Octave --------------------------------------------

    // OMT `035-...-the-rule-of-the-octave-....md` states the Rule as a recipe
    // rather than a table: begin with parallel 6/3 chords over the bass scale,
    // put 5/3 on the tonic, put 5/3 on the dominant, then precede each tonic
    // and dominant with a seventh chord. Every step below is that recipe, one
    // function per step, so that the derivation is the code and not a comment
    // over a hardcoded list.
    //
    // The version OMT uses is "closely based on that of Fedele Fenaroli
    // (Naples, 1775)", and it is one of "many, subtly different versions". So
    // this is *a* Rule of the Octave and says so: nothing here claims that a
    // bass note obliges this chord.
    //
    // The ascent and the descent are separate functions because OMT 35 gives
    // them separately. They differ for one reason, and it is worth stating
    // once: the fourth step of the recipe places a seventh on whatever
    // *precedes* a tonic or dominant, and which degree precedes another
    // depends on which way you are going.
    //
    // The contract this family shares:
    //
    //   Input domain: a collection, and a bass degree written from one. Eight
    //     is the octave and answers as the first degree does.
    //   Output shape: an `option` of a chord class per bass degree — absent
    //     where the collection does not stack to a nameable sonority, which is
    //     how a pentatonic or whole-tone collection reports that it has no
    //     Rule of the Octave.
    //   Direction: fixed per function, and the two really do differ.
    //   Scale and key assumption: a diatonic collection with seven degrees to
    //     the period. No key, no register, no tonic pitch.
    //   Inversion policy: designated, and only designated. A 6/3 and a 6/5
    //     name the third as bass; whether that note actually sounds lowest is
    //     the voicing's decision and is made nowhere in this file.
    //   Voice-leading policy: none. OMT's Fenaroli keeps four voices and
    //     avoids parallels; that is a fact about a realization, and this
    //     returns chord classes rather than realizations.
    //   Not guaranteed: that a bass note obliges its chord. OMT 35 says there
    //     are "many, subtly different versions" and this follows one of them.

    // Step 1. A 6/3 over a bass degree is the triad a third below it, in first
    // inversion. This is the whole of the parallel-sixths harmonization, and
    // it is the same function `std::tonal::sequences` uses for the parallel
    // 6/3 passage, seen from the bass rather than from the root.
    fn sixth_over(collection: Scale, bass: Degree) -> Option<ChordClass> {
        inverted_first(degree_chord(collection, down_steps(bass, 2), 3))
    }

    // Step 2 and step 3 share a shape: a 5/3 is the triad rooted on the bass
    // itself, root position, no designation.
    fn fifth_over(collection: Scale, bass: Degree) -> Option<ChordClass> {
        degree_chord(collection, bass, 3)
    }

    // Step 4. A seventh chord over a bass degree, rooted a third below it so
    // that the bass is still the third — OMT's 6/5 — which is the figure the
    // recipe's seventh chords carry.
    fn six_five_over(collection: Scale, bass: Degree) -> Option<ChordClass> {
        inverted_first(degree_chord(collection, down_steps(bass, 2), 4))
    }

    // Designate the third as bass, keeping absence absent.
    fn inverted_first(content: Option<ChordClass>) -> Option<ChordClass> {
        match content {
            None -> None,
            Some(sounding) -> inversion(sounding, 1),
        }
    }

    // The Rule ascending, one bass degree at a time. Ordinals are written from
    // one and read modulo the collection's period, so eight is the octave and
    // is the tonic again.
    //
    // Where each answer comes from: 1 and 5 are the recipe's 5/3s; 8 is the
    // closing 5/3, which is the same chord as 1 and is written separately
    // because OMT's "first and last" is two places. 4 precedes the dominant
    // and 7 precedes the octave, so both take the recipe's sevenths. The rest
    // are the parallel 6/3s the recipe starts from.
    //
    // The chromatic alteration OMT mentions once — "In one case, this also
    // involves a chromatic alteration for a stronger sense of tonicizing the
    // dominant" — is *not* applied here, and its absence is the point: OMT
    // names it without printing which chord takes it, and a library that
    // guessed would be asserting a version rather than following one. A caller
    // who wants it writes it, and `raise` is how.
    fn rule_ascending_chord(collection: Scale, bass: Nat) -> Option<ChordClass> {
        match bass {
            1 -> fifth_over(collection, degree_of(1)),
            4 -> six_five_over(collection, degree_of(4)),
            5 -> fifth_over(collection, degree_of(5)),
            7 -> six_five_over(collection, degree_of(7)),
            8 -> fifth_over(collection, degree_of(1)),
            _ -> sixth_over(collection, degree_of(bass)),
        }
    }

    // The Rule descending, one bass degree at a time. The 5/3s stand where
    // they stood — a tonic is a tonic whichever way the bass is walking — and
    // the sevenths move, because 6 is what precedes the dominant coming down
    // and 2 is what precedes the tonic.
    fn rule_descending_chord(collection: Scale, bass: Nat) -> Option<ChordClass> {
        match bass {
            1 -> fifth_over(collection, degree_of(1)),
            2 -> six_five_over(collection, degree_of(2)),
            5 -> fifth_over(collection, degree_of(5)),
            6 -> six_five_over(collection, degree_of(6)),
            8 -> fifth_over(collection, degree_of(1)),
            _ -> sixth_over(collection, degree_of(bass)),
        }
    }

    // The bass scale the Rule is harmonized over, ascending. Eight ordinals
    // and not seven: OMT prints the octave, so the last chord is a tonic
    // again, and the closing 5/3 has somewhere to stand. Written as a literal
    // because the Rule of the Octave is over the octave — there is no count
    // here to vary, which is exactly what distinguishes it from the sequences
    // in `std::tonal::sequences`, where the count is the whole point.
    fn rule_ascending_basses() -> List<Nat> { [1, 2, 3, 4, 5, 6, 7, 8] }

    // The same descending. Written out rather than reversed, because a descent
    // is its own line and OMT gives it as one.
    fn rule_descending_basses() -> List<Nat> { [8, 7, 6, 5, 4, 3, 2, 1] }

    // The whole ascending Rule: eight chords over the ascending bass scale.
    fn rule_of_the_octave_ascending(collection: Scale) -> List<Option<ChordClass>> {
        map(rule_ascending_chord(collection), rule_ascending_basses())
    }

    // The whole descending Rule.
    fn rule_of_the_octave_descending(collection: Scale) -> List<Option<ChordClass>> {
        map(rule_descending_chord(collection), rule_descending_basses())
    }
}
