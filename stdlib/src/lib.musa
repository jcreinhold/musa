// The standard library's module tree.
//
// Order is reading order, not dependency order: `core` first because
// everything assumes it, then the shared algebraic vocabulary, then the
// finite-data modules, then pitch and the collections built on it, then the
// two theory subtrees.

mod core;
mod algebra;
mod indexed;
mod list;
mod cyclic;
mod pitch;
mod scale;
mod collections;
mod harmony;
mod voicing;
mod context;
mod notation;
mod sound;
mod transformational;
mod tonal;
mod post_tonal;

// The package's phase modules, which only a syntax import reaches.
mod adapters;
