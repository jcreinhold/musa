// `doubled` — the smallest adapter there is, and the phase's fixture.
//
// A region `syntax doubled { c4 }` expands to `(repeat(c4, 2), 0)`: whatever
// the region holds, twice, paired with the anchor of the group it was rebuilt
// from. It is here to be run rather than to be useful — it exercises
// resolution, expansion, refusal, the record, the anchor table, the source map,
// and the charges, and it is deliberately not a draft of the staff or studio
// adapters.
//
// The anchor is the other half of pointing. Refusing points at a node while the
// expansion is still running; an anchor is a number the produced *value* keeps,
// so a package function complaining about that value three passes later is
// still complaining about a place in the composer's text. The adapter never
// learns what the place is: `syntax_anchor` answers with a node to splice, the
// compiler owns the table from number to range, and the number alone means
// nothing without it.
//
// What it shows about the interface: the region arrives as a syntax value and
// leaves as one, the fold is the only way in, `syntax_built` is the only way to
// make a place for a new node, and the contents are preserved by being rebuilt
// rather than by being quoted. Nothing here reads a type, a value, a file, or a
// clock: given a region, the answer is the same answer every time.
//
// Its contract is the flat one a fixture can keep: the region holds one
// expression's worth of tokens. A region with a nested `{ … }` inside it gets
// the same treatment applied at each group, which is well defined and is not
// what anybody wants — the real adapters read their regions, and this one only
// wraps them.
//
// A `;` is how a writer ends a statement, so a region holding one was written
// against some other reader. That is the one thing this adapter refuses, and
// refusing is what makes both halves of `Syntax -> Result<Syntax, (Syntax,
// Text)>` reachable in a fixture rather than only one of them.
//
// It points with a node rather than with a place. `syntax_at` gives back the
// *input* node at a path, its source information intact, and the compiler reads
// the range off that node. An adapter has no operation for reading a range and
// needs none in order to say which `;` it means.
//
// Two folds, then, rather than one carrying a pair: reading the region and
// reading it for the thing it will not accept are two questions, and asking
// them separately keeps each fold's step functions as simple as the original.
//
// The module is the adapter's scope. `expand` reads the module's own `data`
// and its own `fn`s, because they are declarations of the module it is
// declared in — the phase checks and evaluates the whole module, not one
// spliced expression. Even a fixture this small is better for it: `Refusal`
// says what the first fold is looking for, and `first_refusal` says how two of
// them combine, where before both were an anonymous `Option<Syntax>` and a
// nested `option_fold` a reader had to decode.

library {

    // What the first fold is looking for: a node this adapter will not read,
    // or nothing wrong yet.
    //
    // A `data` rather than an `Option<Syntax>`, and the difference is the
    // name. Two fields would be indistinguishable from any other pair of a
    // node and an absence; `Refusal` says which question this fold is asking.
    data Refusal {
        Nothing,
        Found(node: Syntax<TokenTree>),
    }

    // The first refusal among two, in the order they were written.
    //
    // A left-to-right `list_fold_from_start` over a group's children carries
    // the refusal it already has, so this is what "the first `;` in the region"
    // means, and it is one named function rather than a fold nested inside a
    // fold.
    let first_refusal = fn (found: Refusal, later: Refusal) {
        match found {
            Found(node) -> Found(node),
            Nothing -> later,
        }
    };

    // The refusal a node standing at `here` amounts to, when the region still
    // has a node there.
    //
    // `syntax_at` answers with an `Option` and this fold carries a `Refusal`,
    // so somewhere the two have to meet; giving that meeting a name is what
    // keeps the fold's step one line long. Both parameters are annotated,
    // which an adapter can do because the phase's own types have a spelling in
    // the module it is written in.
    let found_at = fn (region: Syntax<TokenTree>, here: NodePath) {
        option_fold(Nothing, fn (node) { Found(node) }, syntax_at(region, here))
    };

    // What this adapter promises, of `26-language-design-decision.md` §4's
    // three levels. It is checked where the module is imported: a level is a
    // promise a musician relies on, so a module that declared `generative` and
    // held no printer would be refused there rather than found out later.
    //
    // Editable and not generative, and the reason is worth writing down. A
    // region of this adapter produces `(Music, Nat)`, and a printer would have
    // to write a musical value back as source text — which the source language
    // gives it no way to do. The spellings of prompt 127dcfah are the reader's
    // inverse over the five domains that *have* a literal — a whole number, an
    // exact rational, a pitch, a key, an interval — and a `Music` is not one of
    // them: what names it is the expression that built it, and no operation
    // hands that back. Spelling a value the language has no literal for is the
    // staff adapter's problem, and prompt 127dcf is where it is solved.
    let level = "editable";

    let expand = fn (region) {
        match syntax_fold_from_leaves(
            fn (here) { Nothing },
            // Where the refusal is found and where it is pointed are the same
            // node: `syntax_at` hands back the composer's own `;` rather than
            // the rebuilt one, and its source information is what the compiler
            // reads the range from.
            fn (here, kind, text) {
                if token_kind_equal(kind, TokenKind.Semicolon) {
                    found_at(region, here)
                } else { Nothing }
            },
            fn (here, name) { Nothing },
            // The first refusal among the children, in the order they are
            // written: `list_fold_from_start` runs left to right, and the
            // sibling `first_refusal` says what "first" means once, here
            // rather than inside the step.
            fn (here, delimiter, children) {
                list_fold_from_start(
                    Nothing,
                    fn (child, found) { first_refusal(found, child) },
                    children,
                )
            },
            region,
        ) {
            Found(node) -> Err((
                node,
                "this region holds a `;`, and I read one expression's worth of tokens"
            )),
            Nothing -> Ok(syntax_fold_from_leaves(
                fn (here) { syntax_token(syntax_built(here, 0, 0), TokenKind.Error, "") },
                fn (here, kind, text) { syntax_token(syntax_built(here, 1, 0), kind, text) },
                fn (here, name) { syntax_identifier(syntax_built(here, 2, 0), name) },
                fn (here, delimiter, children) {
                    syntax_group(syntax_built(here, 9, 0), Delimiter.Parentheses, [
                        syntax_group(syntax_built(here, 3, 0), Delimiter.Layout, [
                            syntax_identifier(syntax_built(here, 4, 0), "repeat"),
                            syntax_group(syntax_built(here, 5, 0), Delimiter.Parentheses, [
                                syntax_group(
                                    syntax_built(here, 6, 0),
                                    Delimiter.Layout,
                                    children,
                                ),
                                syntax_token(syntax_built(here, 7, 0), TokenKind.Comma, ","),
                                syntax_token(syntax_built(here, 8, 0), TokenKind.Integer, "2"),
                            ]),
                        ]),
                        syntax_token(syntax_built(here, 10, 0), TokenKind.Comma, ","),
                        option_fold(
                            syntax_token(syntax_built(here, 12, 0), TokenKind.Integer, "0"),
                            fn (node) { node },
                            syntax_anchor(region, here, syntax_built(here, 11, 0)),
                        ),
                    ])
                },
                region,
            )),
        }
    };

    // The second declared operation, which makes this adapter *editable* rather
    // than merely readable. One command, `replace`: put this text where the
    // node the command names stands.
    //
    // The node is named by anchor, and the anchor is echoed straight back. That
    // is the whole of what an adapter may do with a place — it names a node it
    // was given, and the compiler owns the translation to a range. An adapter
    // that computed byte offsets would need an operation for reading them, and
    // there is none.
    //
    // Everything the law asks for follows from that. The patch lands inside the
    // region because an anchor of this region is inside this region; nothing
    // outside the named range is touched, because nothing else is returned; and
    // re-expanding the patched region agrees with replacing that node, because
    // replacing the node is exactly what the patch does.
    let edit = fn (region, command, anchor, argument) {
        match command {
            "replace" -> Ok([(anchor, argument)]),
            _ -> Err("`doubled` serves one command, `replace`"),
        }
    };
}
