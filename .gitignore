# ============================================================================
# Musa workspace .gitignore
# ============================================================================

# ----------------------------------------------------------------------------
# Rust / Cargo
# ----------------------------------------------------------------------------
# Build output for every crate in the workspace.
/target
**/target

# Remove the backup files generated by `cargo fmt` when it fails.
**/*.rs.bk

# Local cargo configuration / caches.
.cargo/config.local

# MSVC-style debug info artifacts (Windows).
*.pdb

# ----------------------------------------------------------------------------
# musa domain artifacts
# ----------------------------------------------------------------------------
# Autosave copies (musa-project/src/autosave.rs). They sit beside the file
# they recover and are deleted on save; none of them belongs in history.
*.recovery

# Performance sidecars (musa-project/src/realization.rs). Same rule: they sit
# beside the piece, they record one reading of it, and the piece is the work.
*.performance

# Rendered / exported artifacts derived from .musa sources. The source is
# canonical; regenerable audio and notation output stays out of history.
*.wav
*.aif
*.aiff
*.flac
*.mp3
*.ogg
*.mid
*.midi
*.pdf
*.ly
*.mei
*.musicxml

# ----------------------------------------------------------------------------
# Node / pnpm / frontend (apps/musa-desktop/ui, packages/*)
# ----------------------------------------------------------------------------
node_modules/
**/node_modules/

# Package-manager logs and caches.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-debug.log

# Vite / SvelteKit / build output.
dist/
**/dist/
.svelte-kit/
**/vite.config.ts.timestamp-*

# Test & coverage output (Playwright, Vitest).
**/test-results/
**/playwright-report/
**/coverage/
.nyc_output/

# Frontend tooling caches.
*.tsbuildinfo
.eslintcache
.prettier-cache
.turbo/

# ----------------------------------------------------------------------------
# Tauri (apps/musa-desktop/src-tauri)
# ----------------------------------------------------------------------------
# Release signing keypair — NEVER commit the private key.
*.pem
*.key
src-tauri/gen/keys

# Local dev certificates / provisioning.
*.mobileprovision

# ----------------------------------------------------------------------------
# tree-sitter (editors/tree-sitter-musa)
# ----------------------------------------------------------------------------
# Generated parser artifacts and native bindings.
bindings/node/build/
bindings/node/prebuilds/
**/tree-sitter-musa/src/*.o
**/tree-sitter-musa/src/*.so
*.dylib
*.dll
*.wasm

# ----------------------------------------------------------------------------
# WASM (crates/musa-wasm, packages/musa-web)
# ----------------------------------------------------------------------------
wasm-pack.log
pkg/
**/pkg/

# ----------------------------------------------------------------------------
# Editors / IDEs
# ----------------------------------------------------------------------------
# VS Code: keep shared settings out (project settings are per-developer).
.vscode/
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains family.
.idea/
*.iml
*.ipr
*.iws

# Vim / Neovim.
*.swp
*.swo
*~
.netrwhist

# Emacs / Lisp tags.
TAGS
GPATH
GRTAGS
GTAGS

# ----------------------------------------------------------------------------
# Environment & secrets
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template

# ----------------------------------------------------------------------------
# OS junk
# ----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ----------------------------------------------------------------------------
# Tooling caches & local state
# ----------------------------------------------------------------------------
# Python (scripts).
__pycache__/
*.py[cod]
.venv/

# misc caches
.cache/
.direnv/
*.log

# Profiling / benchmark artifacts.
*.profraw
*.perf
flamegraph.svg

# @musa/web build outputs (prompts 140, 143): rebuilt by vite, never committed.
packages/musa-web/dist-cdn/
packages/musa-web/examples/build-time/out/

# Agent runtime artifacts: pi sessions and subagent state are local-only,
# and Claude's settings.local.json holds per-machine permission overrides.
.pi/sessions/
.pi-subagents/
.claude/settings.local.json
