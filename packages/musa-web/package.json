{
  "name": "@musa/web",
  "version": "0.1.0",
  "type": "module",
  "description": "Typeset musa scores in the browser: MathJax-like engraving for the musa language",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cdn": "./dist-cdn/musa-web.js",
    "./wasm": "./wasm/musa_wasm_bg.wasm"
  },
  "files": [
    "dist",
    "dist-cdn",
    "wasm"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "vite build",
    "build:cdn": "vite build --config vite.cdn.config.ts && node scripts/prepare-cdn.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run && playwright test",
    "prepublishOnly": "bash ../../scripts/build-wasm.sh && pnpm run test && pnpm run build && pnpm run build:cdn"
  },
  "dependencies": {
    "musa-engrave": "workspace:*"
  },
  "peerDependencies": {
    "verovio": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.1.2",
    "typescript": "^5.7.0",
    "verovio": "6.2.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.7"
  }
}
