f\" tie=\"i\"/>\n                </layer>\n              </staff>\n              <staff n=\"2\">\n                <layer xml:id=\"layer-2-1\" n=\"1\">\n                  <note xml:id=\"event-c\" dur=\"1\" oct=\"4\" pname=\"a\"/>\n                </layer>\n                <layer xml:id=\"layer-2-2\" n=\"2\">\n                  <note xml:id=\"event-10\" dur=\"1\" oct=\"2\" pname=\"d\"/>\n                </layer>\n              </staff>\n            </measure>\n            <measure n=\"4\" right=\"end\">\n              <staff n=\"1\">\n                <layer xml:id=\"layer-1-1\" n=\"1\">\n                  <note xml:id=\"event-7-t2\" dur=\"4\" oct=\"4\" pname=\"f\" tie=\"t\"/>\n                  <note xml:id=\"event-8\" dur=\"4\" oct=\"4\" pname=\"e\"/>\n                  <note xml:id=\"event-9\" dur=\"2\" oct=\"4\" pname=\"d\"/>\n                </layer>\n              </staff>\n              <staff n=\"2\">\n                <layer xml:id=\"layer-2-1\" n=\"1\">\n                  <note xml:id=\"event-d\" dur=\"1\" oct=\"4\" pname=\"g\" accid=\"s\"/>\n                </layer>\n                <layer xml:id=\"layer-2-2\" n=\"2\">\n                  <note xml:id=\"event-11\" dur=\"1\" oct=\"2\" pname=\"e\"/>\n                </layer>\n              </staff>\n            </measure>\n          </section>\n        </score>\n      </mdiv>\n    </body>\n  </music>\n</mei>",
