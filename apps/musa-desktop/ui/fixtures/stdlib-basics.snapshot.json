  "kind": "piece",
  "source": "// Standard modules are explicit, version-matched source libraries. Their\n// functions pass through the same checker and evaluator as these definitions.\npiece \"Standard Library Basics\" {\n    import std::core;\n    import std::list;\n\n    let subject: EventTrack<WrittenTime> = music {\n        c4/4\n        d4/4\n    };\n\n    fn same_pitch(p: Pitch) -> Pitch { p }\n\n    let answer: EventTrack<WrittenTime> = compose_music(\n        fn (line: EventTrack<WrittenTime>) -> EventTrack<WrittenTime> { transpose(P8, line) },\n        retrograde,\n        subject,\n    );\n    let chosen: Pitch = Some(e4).fold_from_end(c4, fn (found, otherwise) { same_pitch(found) });\n    let counting: List<Nat> = naturals(4);\n\n    score {\n        part strings {\n            voice duet {\n                use together(subject, shift(duration_of(1/2), answer));\n                c5/2\n                rest/2\n            }\n        }\n    }\n}\n",
