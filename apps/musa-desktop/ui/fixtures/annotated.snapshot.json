           <staff n=\"1\">\n                <layer xml:id=\"layer-1-1\" n=\"1\">\n                  <note xml:id=\"event-3\" dur=\"2\" oct=\"5\" pname=\"f\"/>\n                  <note xml:id=\"event-4\" dur=\"2\" oct=\"5\" pname=\"e\"/>\n                </layer>\n              </staff>\n              <harm staff=\"1\" tstamp=\"1\" place=\"above\">fmaj7</harm>\n            </measure>\n            <measure n=\"3\">\n              <staff n=\"1\">\n                <layer xml:id=\"layer-1-1\" n=\"1\">\n                  <note xml:id=\"event-5\" dur=\"4\" oct=\"4\" pname=\"b\"/>\n                  <note xml:id=\"event-6\" dur=\"4\" oct=\"5\" pname=\"e\"/>\n                  <note xml:id=\"event-7\" dur=\"2\" oct=\"5\" pname=\"g\" accid=\"s\"/>\n                </layer>\n              </staff>\n              <phrase staff=\"1\" startid=\"#event-5\" endid=\"#event-8\" label=\"consequent\"/>\n              <dir staff=\"1\" startid=\"#event-5\" place=\"above\" type=\"phrase\">consequent</dir>\n              <dir staff=\"1\" tstamp=\"1\" place=\"above\" type=\"section\">Development</dir>\n              <harm staff=\"1\" tstamp=\"1\" place=\"above\">e7</harm>\n            </measure>\n            <measure n=\"4\" right=\"end\">\n              <staff n=\"1\">\n                <layer xml:id=\"layer-1-1\" n=\"1\">\n                  <note xml:id=\"event-8\" dur=\"1\" oct=\"5\" pname=\"a\"/>\n                </layer>\n              </staff>\n              <harm staff=\"1\" tstamp=\"1\" place=\"above\">am</harm>\n            </measure>\n          </section>\n        </score>\n      </mdiv>\n    </body>\n  </music>\n</mei>",
