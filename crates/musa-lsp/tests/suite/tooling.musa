// What a piece needs to know about where it lives.
record Centred {
    // The note name the piece is centred on.
    tonic: NoteName;
}

// The home this study is written from.
let home: Centred = Centred { tonic = chord_root(chord c major) };

piece "Tooling" {
    meter 4/4;
    key c major;

    // The subject, stated once and read everywhere.
    let subject: EventTrack<WrittenTime> = music { c4/4 e4/4 g4/4 e4/4 };

    // Raise a passage by the interval the caller names.
    fn lifted(what: EventTrack<WrittenTime>, by: Interval) -> EventTrack<WrittenTime> {
        transpose(by, what)
    }

    // deprecated: write `subject` instead.
    let theme: EventTrack<WrittenTime> = music { c4/1 };

    let centre: NoteName = home.tonic;
    let raised: EventTrack<WrittenTime> = lifted(subject, P4);

    score {
        part piano {
            voice melody {
                assert realizes(chord c major, may_add) {
                    use subject;
                }
            }
            voice answer {
                use raised;
            }
        }
    }
}
