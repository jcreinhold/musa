    \tempo 4 = 72
    e''2 % event:0
    r4 % event:1
    c''4~ % event:2
    |
    c''4 % event:2
    b'4 % event:3
    a'2 % event:4
    |
    a'2 % event:5
    r4 % event:6
    f'4~ % event:7
    |
    f'4 % event:7
    e'4 % event:8
