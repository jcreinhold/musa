// Stockhausen's Klavierstück XI is nineteen fragments on one large sheet: the
// pianist looks away, looks back, and plays whichever fragment their eye lands
// on, until the sheet has been crossed three times. This file is that *shape* —
// the fragments are written for musa, not transcribed — and it is here because
// nineteen fragments have 19! orderings, which is the number that settled the
// argument in `docs/rules/kernel/11-realization.md`: a finite `choose` cannot hold
// them, and a permutation costs nineteen `u32`s.
//
//     musa kernel examples/mobile.musa --seed 7
//
// The same seed is the same reading, every time; a different seed is a
// different one. That is law R1, and it is what makes a mobile a piece a
// recording can be made of rather than a lottery.
piece "Nineteen" {
    composer "musa, after the form of Klavierstück XI";

    tempo 1/4 = 92;
    meter 4/4;
    key c major;

    fragment group_one {
        b5/8
        g4/8
        ab5/4
        d5/2
    }
    fragment group_two {
        bb4/2
        c#5/2
    }
    fragment group_three {
        f#5/1
        c5/1
    }
    fragment group_four {
        d5/16
        e5/16
        bb4/16
        c#5/16
        eb4/4
        a4/4
        d#5/4
    }
    fragment group_five {
        a4/2
        d#5/2
    }
    fragment group_six {
        g4/2
        ab5/4
        d5/4
    }
    fragment group_seven {
        c#5/4
        eb4/4
        a4/4
        d#5/4
    }
    fragment group_eight {
        c5/2.
        b5/4
    }
    fragment group_nine {
        e5/4
        bb4/8
        c#5/8
        eb4/2
    }
    fragment group_ten {
        d#5/4
        f#5/2
        c5/4
    }
    fragment group_eleven {
        ab5/8
        d5/4
        e5/8
        bb4/8
        c#5/4
        eb4/8
    }
    fragment group_twelve {
        eb4/8
        a4/8
        d#5/8
        f#5/8
        c5/8
        b5/8
        g4/8
        ab5/8
    }
    fragment group_thirteen {
        b5/8
        g4/8
        ab5/4
        d5/2
    }
    fragment group_fourteen {
        bb4/2
        c#5/2
    }
    fragment group_fifteen {
        f#5/1
        c5/1
    }
    fragment group_sixteen {
        d5/16
        e5/16
        bb4/16
        c#5/16
        eb4/4
        a4/4
        d#5/4
    }
    fragment group_seventeen {
        a4/2
        d#5/2
    }
    fragment group_eighteen {
        g4/2
        ab5/4
        d5/4
    }
    fragment group_nineteen {
        c#5/4
        eb4/4
        a4/4
        d#5/4
    }

    score {
        part piano {
            voice right {
                mobile {
                    group_one;
                    group_two;
                    group_three;
                    group_four;
                    group_five;
                    group_six;
                    group_seven;
                    group_eight;
                    group_nine;
                    group_ten;
                    group_eleven;
                    group_twelve;
                    group_thirteen;
                    group_fourteen;
                    group_fifteen;
                    group_sixteen;
                    group_seventeen;
                    group_eighteen;
                    group_nineteen;
                }
            }
        }
    }
}
