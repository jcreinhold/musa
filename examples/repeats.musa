// A repeat is one statement with two projections: the page prints the body
// once between repeat barlines, and the performance plays it through twice.
// The endings are the part that differs — first time out, second time home.
piece "Two Ways Home" {
    tempo quarter = 108;
    meter 4/4;
    key g major;

    score {
        part flute {
            clef treble;

            voice tune {
                repeat 2 {
                    bar { d5 1/4; g5 1/4; f#5 1/4; g5 1/4; }
                    bar { a5 1/2; b5 1/2; }
                    ending 1 {
                        bar { a5 1/2; d5 1/2; }
                    }
                    ending 2 {
                        bar { g5 1; }
                    }
                }
            }
        }

        part cello {
            clef bass;

            voice line {
                repeat 2 {
                    bar { g2 1/2; b2 1/2; }
                    bar { d3 1/2; g2 1/2; }
                    ending 1 {
                        bar { c3 1/2; a2 1/2; }
                    }
                    ending 2 {
                        bar { g2 1; }
                    }
                }
            }
        }
    }
}
