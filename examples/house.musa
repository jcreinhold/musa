// Four-on-the-floor with a pushed bass (docs/plan/prompts/69).
//
// Every part here is written on the grid, because that is what the grid is
// for. What makes it move is that the bass's offbeat eighths land a
// sixty-fourth early — the anticipation of house and garage, and a thing no
// notation has an element for. It is a groove, so it is written once in the
// profile and nowhere on the page.
//
// The kick does *not* push. That asymmetry is the piece: a groove is per
// part, because the whole effect is one part disagreeing with another on
// purpose.
piece "House" {
    tempo 1/4 = 124;
    meter 4/4;
    key a minor;

    // Each part's pattern is material repeated, not a written repeat barline:
    // the three disagree about how long a pattern is, and a barline cannot.
    fragment four_on_the_floor {
        repeat 16 {
            c2/4
            c2/4
            c2/4
            c2/4
        }
    }

    fragment bass_a {
        repeat 4 {
            rest/8
            a2/8
            rest/8
            a2/8
            rest/8
            a2/8
            rest/8
            c3/8
            rest/8
            a2/8
            rest/8
            a2/8
            rest/8
            g2/8
            rest/8
            e2/8
        }
    }

    fragment bass_b {
        repeat 4 {
            rest/8
            f2/8
            rest/8
            f2/8
            rest/8
            f2/8
            rest/8
            a2/8
            rest/8
            g2/8
            rest/8
            g2/8
            rest/8
            d3/8
            rest/8
            c3/8
        }
    }

    fragment stab_bar {
        repeat 16 {
            rest/8
            [a4 c5 e5]/8
            rest/8
            [a4 c5 e5]/8
            rest/8
            [g4 c5 e5]/8
            rest/8
            [g4 b4 e5]/8
        }
    }

    performance {
        // Negative is early. `by` may not reach `grid`, or the offbeat would
        // arrive on top of the downbeat before it and the warp would stop
        // being a warp — the compiler refuses that rather than clamping it.
        profile bassline {
            groove push {
                grid = 1/8;
                by = -1/64;
            }
            dynamic f {
                amplitude = 0.9;
            }
        }

        // Straight, said out loud: the kick is the reference everything else
        // is early against, so it names its groove rather than inheriting a
        // default nobody can see.
        profile floor {
            groove straight {
            }
            dynamic f {
                amplitude = 0.95;
            }
        }

        profile keys {
            groove push {
                grid = 1/8;
                by = -1/64;
            }
            dynamic mf {
                amplitude = 0.55;
            }
        }
    }

    score {
        part kick {
            clef bass;
            profile floor;

            voice pulse {
                dynamic f;
                use four_on_the_floor;
            }
        }

        part bass {
            clef bass;
            profile bassline;

            voice line {
                dynamic f;

                // The offbeats carry the line, which is exactly what the push
                // moves; the downbeat rests are what make them audible.
                use bass_a;
                use bass_b;
            }
        }

        part chords {
            clef treble;
            profile keys;

            voice stabs {
                dynamic mf;

                // Offbeat chord stabs, pushed with the bass so the two agree
                // and the kick is the only thing on the grid.
                use stab_bar;
            }
        }
    }
}
