// A passage for which "nothing" is the only honest answer.
//
// Four symmetrical sonorities: a whole-tone collection, a chromatic cluster,
// another cluster, and a five-note set sounding both spellings of C. No key's
// collection contains any of their class sets, and none of them is a chord
// this vocabulary names.
//
// So `musa analyze --kind tonal` reports nothing at all, `--kind cadences`
// reports nothing at all, and `--kind chords` reports the four sonorities —
// which are facts, they sound — and no fit for any of them. That absence is the finding. There is no weak label, no
// nearest triad, and no confidence number: `docs/language/07-analysis.md` §3
// forbids a number nobody can derive, and §7's `chords` domain contains only
// the four stated relations, none of which these notes stand in.
//
// This fixture exists so that a future change which starts naming these is
// caught immediately. A reading that answers everything is a reading that has
// stopped meaning anything.
piece "Unknown Passage" {
    composer "musa";

    tempo 1/4 = 60;
    meter 4/4;
    key c major;

    score {
        part piano {
            clef treble;

            voice upper {
                | [c4 d4 e4 f#4 g#4 a#4]/1
                | [c4 c#4 d4 d#4]/1
                | [f#4 g4 g#4 a4]/1
                | [c4 c#4 e4 f#4 g4]/1
            }
        }
    }
}
