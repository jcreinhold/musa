// Second species: two notes against one (OMT `025-second-species-counterpoint.md`).
//
//     musa analyze examples/analysis/species-2.musa --kind counterpoint \
//         --profile species_2 --cantus cantus
//
// Bars 1-4 are correct, and bar 1 shows what the species is for: the weak-beat
// b3 is a seventh above the cantus, and it is allowed because it is stepped
// into and stepped out of in the same direction. Bars 5-7 depart -- two weak
// dissonances that are left by repeating the note instead of stepping on, and
// a cadence reached in parallel octaves.
piece "Second Species" {
    composer "musa";

    tempo 1/4 = 60;
    meter 4/4;
    key c major;

    score {
        part exercise {
            clef treble;

            voice counter {
                | c4/2 b3/2
                | a3/2 b3/2
                | c4/2 b3/2
                | a3/2 c4/2
                | c4/2 d4/2
                | d4/2 c4/2
                | c4/1
            }

            voice cantus {
                | c3/1
                | d3/1
                | e3/1
                | f3/1
                | e3/1
                | d3/1
                | c3/1
            }
        }
    }
}
