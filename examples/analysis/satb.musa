// Four-part writing, correct and then deliberately not (OMT `022-chords-in-satb-style.md`).
//
// Read it with:
//
//     musa analyze examples/analysis/satb.musa --kind voice-leading --profile satb_common_practice
//
// The profile is named by the request and never by this file. What is written
// here is music; `satb_common_practice` is one tradition's way of reading it,
// and a document that named its own reading would be asserting a style it
// merely happens to be written in.
//
// Bars 1-3 depart from nothing, and each voice states that in the source: the
// `assert follows(satb_parallel_perfects)` block around them is checked when
// the file compiles, and it is the only place in this file where a style rule
// stops a build. Bars 4-7 depart, and the analysis reports:
//
//   4  every voice rises a step at once — parallel fifths bass to tenor and
//      parallel octaves bass to alto, both from the same motion.
//   5  the alto climbs to d5, past the f4 the soprano has just left.
//   6  the tenor and alto lie a tenth apart, and then an eleventh in bar 7,
//      which is more than the octave OMT 022 allows between adjacent upper
//      voices.
//   6  the leading tone in the tenor falls a third to *sol* instead of rising.
//
// Six departures, five of them `hard in this exercise` and the tendency-tone
// one a `guideline`: what this pedagogy asks of a student, not facts about
// music. The report says which is which and never flattens the two.
piece "SATB Study" {
    composer "musa";

    tempo 1/4 = 72;
    meter 4/4;
    key c major;

    score {
        part choir {
            clef treble;

            voice bass {
                assert follows(satb_parallel_perfects) {
                    | c3/1
                    | g2/1
                    | c3/1
                }

                | c3/1
                | d3/1
                | g2/1
                | c3/1
            }

            voice tenor {
                assert follows(satb_parallel_perfects) {
                    | g3/1
                    | g3/1
                    | g3/1
                }

                | g3/1
                | a3/1
                | b3/1
                | g3/1
            }

            voice alto {
                assert follows(satb_parallel_perfects) {
                    | c4/1
                    | b3/1
                    | c4/1
                }

                | c4/1
                | d4/1
                | d5/1
                | c5/1
            }

            voice soprano {
                assert follows(satb_parallel_perfects) {
                    | e4/1
                    | d4/1
                    | e4/1
                }

                | e4/1
                | f4/1
                | f5/1
                | e5/1
            }
        }
    }
}
