// Jazz voicings, and why every rule below is a guideline (OMT `076-jazz-voicings.md`).
//
//     musa analyze examples/analysis/jazz-voice-leading.musa \
//         --kind voice-leading --profile jazz_voice_leading
//
// OMT 076's own section is titled "Guidelines versus Rules", and this profile
// takes it at its word: not one of its six rules is reported as `hard in this
// exercise`. A pianist who leaps a tenth to reach a voicing has not made a
// mistake, and the report says so by carrying the strength beside every
// finding rather than counting errors.
//
// Bars 1-3 are a ii-V-I voiced the way the chapter voices one: both guide
// tones present in every chord, held or moved by step, and no upper voice
// travelling further than a step. The bass leaps a fifth twice and is not
// reported for it -- the motion guideline is about the voicing, and a rule
// that scolded a walking bass would fire on every ii-V ever written.
//
// Bars 4-6 depart, and they show something true about voicings: a bad one is
// rarely bad in only one way. Bar 4 drops the seventh of the ii chord, and the
// soprano leaps an octave to get there. Bar 5 opens a tenth between the alto
// and the soprano, and the two guide tones jump to reach it. Bar 6 stacks two
// seconds below middle C, where the chapter says a voicing turns muddy. Nine
// findings, and every one of them a guideline.
piece "Jazz Voice Leading" {
    composer "musa";

    tempo 1/4 = 120;
    meter 4/4;
    key c major;

    score {
        harmony {
            at 1:1 dm7;
            at 2:1 g7;
            at 3:1 cmaj7;
            at 4:1 dm7;
            at 5:1 g7;
            at 6:1 cmaj7;
        }

        part piano {
            clef treble;

            voice bass {
                | d3/1
                | g2/1
                | c3/1
                | d3/1
                | g2/1
                | c3/1
            }

            voice tenor {
                // A guide tone held across a chord change is the technique, not
                // a motif nobody named: `f` is the third of the ii chord and
                // the seventh of the V, and writing it out is the point.
                // musa:allow(copied-bars)
                | f3/1
                // musa:allow(copied-bars)
                | f3/1
                | e3/1
                // musa:allow(copied-bars)
                | f3/1
                // musa:allow(copied-bars)
                | f3/1
                | d3/1
            }

            voice alto {
                | a3/1
                // musa:allow(copied-bars)
                | b3/1
                // musa:allow(copied-bars)
                | b3/1
                | a3/1
                // musa:allow(copied-bars)
                | b3/1
                | e3/1
            }

            voice soprano {
                | c4/1
                | d4/1
                | e4/1
                | d4/1
                | d5/1
                | b3/1
            }
        }
    }
}
