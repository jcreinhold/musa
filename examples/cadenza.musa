// A measured movement with an unmeasured cadenza inside it (docs/plan/prompts/74).
//
// The cadenza is `senza { ... }`: the barlines stop for exactly as long as the
// braces say and the meter that resumes is the one that was already in force,
// so there is no second meter statement to keep in step with the first.
//
// What it costs is the thing worth pointing at. An unmeasured stretch is one
// measure — measure 5 here — and the measure number does not advance across
// it, so the movement resumes at measure 6. That is not a limitation of the
// representation; it is how a conductor's score numbers a cadenza, and the
// alternative design (barlines with gaps in them) would have numbered it
// wrong while looking more faithful.
piece "Cadenza" {
    tempo 1/4 = 88;
    meter 4/4;
    key d minor;

    score {
        part soloist {
            clef treble;

            voice solo {
                | dynamic mf;

                // Four measured bars: 1 through 4.
                d5/4
                f5/4
                a5/4
                d6/4

                | c#6/2 a5/2

                | bb5/4 g5/4 e5/4 c#5/4

                | d5/1

                // Measure 5, and it is one measure however long it runs.
                senza {
                    d5/8
                    e5/8
                    f5/8
                    g5/8
                    a5/8
                    bb5/8
                    c#6/8
                    d6/8
                    e6/16
                    d6/16
                    c#6/16
                    d6/16
                    a5/4
                    d5/2
                }

                // Measure 6: the movement, where it left off.
                | d5/4 a5/4 f5/4 d5/4

                | d5/1
            }
        }
    }
}
