piece "Glass Mountain" {
    tempo quarter = 72;
    meter 4/4;
    key a minor;

    motif sigh(root: pitch = e5) {
        root 1/2;
        rest 1/4;
        c5 1/2;
        b4 1/4;
        a4 1/2;
    }

    score {
        part violin {
            clef treble;

            voice lead {
                use sigh();

                transpose down P5 {
                    use sigh();
                }
            }
        }

        part strings {
            voice upper {
                c5 1;
                c5 1;
                a4 1;
                gs4 1;
            }

            voice bass {
                a2 1;
                f2 1;
                d2 1;
                e2 1;
            }
        }
    }
}
