piece "Counterpoint Study" {
    tempo quarter = 90;
    meter 4/4;
    key d minor;

    score {
        part violin {
            clef treble;

            voice lead {
                bar { d4 1/2; f4 1/2; }
                bar { e4 1/2; chord [d4, fs4, a4] 1/2; }
            }
        }

        part viola {
            clef alto;

            voice line {
                bar { d3 1/2; a2 1/2; }
                bar { bf2 1/2; a2 1/2; }
            }
        }
    }
}
