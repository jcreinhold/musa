piece "Counterpoint Study" {
    tempo quarter = 90;
    meter 4/4;
    key d minor;

    score {
        part violin {
            clef treble;

            voice lead {
                | d4/2 f4/2
                | e4/2 [d4 f#4 a4]/2 fermata
            }
        }

        part viola {
            clef alto;

            voice line {
                | d3/2 a2/2
                | bb2/2 a2/2 fermata
            }
        }
    }
}
