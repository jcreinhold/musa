piece "canon" {
    tempo 1/4 = 96;
    meter 3/4;
    key g major;

    motif theme() {
        g4/4
        a4/4
        b4/4
        g4/4
        c5/2
        b4/2
        a4/2
        g4/2
    }

    score {
        part strings {
            voice dux {
                use theme();
            }
            voice comes {
                rest/2.
                transpose up P5 {
                    use theme();
                }
            }
        }
    }
}
