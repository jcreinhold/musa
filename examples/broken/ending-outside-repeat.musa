// An ending is the part of a repeat that differs between passes, so it needs
// a repeat to differ inside. On its own it is just a bar with a number in
// front of it, and the number would mean nothing.
piece "Alone" {
    tempo quarter = 96;
    meter 4/4;

    score {
        part piano {
            voice right {
                | c4/4 d4/4 e4/4 f4/4
                ending 1 {
                    | g4/1
                }
            }
        }
    }
}
