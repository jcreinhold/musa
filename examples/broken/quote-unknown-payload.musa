// The event track is parametric in what its occurrences carry; this compiler
// implements exactly one payload, and a quote that asks for another is asking
// for a meaning nothing here can give it. The refusal is at the type, before a
// single occurrence is read.
piece "Quote Unknown Payload" {
    let assembled: EventTrack<WrittenTime> = events EventTrack[WrittenTime, Sample] {
        track 1 {
            occurrence "note c4 1" from 0 to 1;
        }
    };

    score {
        part solo {
            voice line {
                use assembled;
            }
        }
    }
}
