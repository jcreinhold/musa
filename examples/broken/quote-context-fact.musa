// Key, meter, clef and tempo hold from where they are written until they are
// written again, so a value carrying one would change its caller's context from
// inside. A `music` value may read the context supplied at each use; it may not
// settle it — and a quote is a `music` value like any other.
piece "Quote Context Fact" {
    let assembled: EventTrack(WrittenTime) = events EventTrack[WrittenTime, ScoreFact] {
        together {
            track 1 {
                occurrence "key c major" from 0 to 1;
            };
            track 1 {
                occurrence "note c4 1" from 0 to 1;
            };
        }
    };

    score {
        part solo {
            voice line {
                use assembled;
            }
        }
    }
}
