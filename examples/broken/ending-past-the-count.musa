// Three endings under a repeat that is played twice. The third one is written
// for a pass that never happens, and the repeat's own count is the other half
// of the story — so the diagnostic points at both.
piece "Third Time" {
    tempo quarter = 96;
    meter 4/4;

    score {
        part piano {
            voice right {
                repeat 2 {
                    bar { c4 1/4; d4 1/4; e4 1/4; f4 1/4; }
                    ending 1 {
                        bar { g4 1; }
                    }
                    ending 2 {
                        bar { a4 1; }
                    }
                    ending 3 {
                        bar { b4 1; }
                    }
                }
            }
        }
    }
}
