piece "Missing Unit" {
    meter 4/4;

    score {
        part piano {
            clef treble;
            voice right {
                c5/1
            }
        }
    }

    instrument warm conforms note_instrument {
        implementation graph {
            oscillator(sine) |> lowpass(cutoff: 1400) |> output;
        }
    }

    studio {
        assign piano -> warm;
    }
}
