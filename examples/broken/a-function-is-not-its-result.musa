// `echo` takes an argument, and taking one is not the same as being a
// value: the function's type is `Pitch -> Pitch`, and naming it without the
// argument names the function, not a pitch. (The old checker's nullary case
// is gone rather than excepted: `fn beats() -> Nat` binds no parameter, so
// there is no arrow for it to have — the declaration is a plain `Nat`, and
// `beats` and `beats()` are two spellings of the same use.)
piece "A Function Is Not Its Result" {
    fn echo(tone: Pitch) -> Pitch { tone }

    let start: Pitch = echo;

    score {
        part solo {
            voice line {
                c4/1
            }
        }
    }
}
