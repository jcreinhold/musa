// A bar says how long it is. This one is a quarter over, which without the
// braces would have been silent: every later barline in the voice one quarter
// out of place, and nothing to point at.
piece "Over" {
    tempo quarter = 96;
    meter 4/4;

    score {
        part piano {
            voice right {
                bar { c4 1/4; d4 1/4; e4 1/4; f4 1/4; }
                bar { g4 1/4; a4 1/4; b4 1/4; c5 1/4; d5 1/4; }
            }
        }
    }
}
