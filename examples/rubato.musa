// A ritardando and an a tempo (docs/plan/prompts/73).
//
// A gradual tempo change is written as where it arrives and how far it takes
// to get there: `tempo 1/4 = 72 to 48 over 2/1;` says the quarter slows from
// 72 to 48 across two whole notes. What happens in between is a shape, and
// the shape is in the score rather than in any one performance of it.
//
// The interpolation is linear in *seconds per beat*, not in beats per minute.
// That is not a rounding decision: interpolating bpm makes each beat's
// duration a reciprocal, so the elapsed time stops being rational and the
// exactness the whole temporal model rests on is gone. Interpolating duration
// keeps every intermediate value exact — and it is also what an orchestra
// plays when it is told to slow down evenly, so the representable answer and
// the musical one are the same answer.
//
// The last marking is a word with no number: *poco rit.* over a whole note
// prints, and moves no clock. Which is the point — the page can say more than
// the map does, and a design that fused them could not.
piece "Rubato" {
    tempo 1/4 = 72;
    meter 4/4;
    key g major;

    score {
        part violin {
            clef treble;

            voice tune {
                dynamic mp;

                // Two bars in tempo, so there is something for the rit. to be
                // slower than.
                d5/4
                g5/4
                a5/4
                b5/4

                c6/2
                b5/2

                // Slowing across two whole notes: two bars, arriving at 48.
                tempo 1/4 = 72 to 48 over 2/1 "rit.";
                a5/4
                g5/4
                f#5/4
                e5/4

                d5/2
                b4/2

                // Back in tempo. A marking after a ramp is a marking like any
                // other; nothing here knows a ramp came before it.
                tempo 1/4 = 72 "a tempo";
                g5/4
                a5/4
                b5/4
                c6/4

                // A word with a reach and no number: printed, and the clock
                // is untouched.
                tempo "poco rit." over 1/1;
                d6/2
                b5/2

                g5/1
            }
        }
    }
}
