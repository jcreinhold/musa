// Standard modules are explicit, version-matched source libraries. Their
// functions pass through the same checker and evaluator as these definitions.
piece "Standard Library Basics" {
    import std::core;
    import std::list;

    let subject: EventTrack(WrittenTime) = music {
        c4/4
        d4/4
    };

    fn same_pitch(p: Pitch) -> Pitch { p }

    let answer: EventTrack(WrittenTime) = compose_music(
        fn (line: EventTrack(WrittenTime)) -> EventTrack(WrittenTime) { transpose(P8, line) },
        retrograde,
        subject,
    );
    let chosen: Pitch = Some(e4).fold_from_end(c4, fn (found, otherwise) { same_pitch(found) });
    let counting: List(Nat) = naturals(4);

    score {
        part strings {
            voice duet {
                use together(subject, shift(duration_of(1/2), answer));
                c5/2
                rest/2
            }
        }
    }
}
