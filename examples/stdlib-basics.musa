// Standard modules are explicit, version-matched source libraries. Their
// functions pass through the same checker and evaluator as these definitions.
piece "Standard Library Basics" {
    import std::core;
    import std::list;
    import std::option;

    let subject: Music = music {
        c4/4
        d4/4
    };

    fn same_pitch(p: Pitch) -> Pitch { p }

    let answer: Music = compose_music(fn (line: Music) -> Music { transpose(P8, line) }, retrograde, subject);
    let chosen: Pitch = pitch_or_else(c4, same_pitch, Some(e4));
    let counting: List<Nat> = naturals(4);

    score {
        part strings {
            voice duet {
                use together(subject, shift(1/2, answer));
                c5/2
                rest/2
            }
        }
    }
}
