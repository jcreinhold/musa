// Diatonic sequences: a pattern, a count, and nothing else.
//
// OMT `049-diatonic-sequences-in-middles.md` names sequences by the interval
// their roots move — descending fifths, descending thirds, ascending seconds —
// and every one of them is index arithmetic on scale degrees. So every one of
// them is an ordinary function in `std::tonal::sequences`: no sequence
// keyword, no generator, no recursion, and no rule about how long to go on.
// The count is the caller's, which is why each pattern below is written twice
// at two lengths and neither is the library's opinion.
//
// The same skeleton is voiced two ways, as in `rule-of-the-octave.musa`: close
// position in quarters, and drop-2 in halves. A chord class chooses no
// register, no spacing, and no rhythm, so it cannot be played until this file
// says how.

piece "Diatonic Sequences" {
    import std::tonal::sequences;
    import std::scale;
    import std::voicing;

    tempo 1/4 = 108;
    meter 4/4;
    key c major;

    let major: Scale = scale c major;
    let minor: Scale = scale a natural_minor;
    let first: Degree = degree_of(1);

    // Close position from C3, a quarter long.
    fn close_quarter(sounding: ChordClass) -> Music {
        match close_position(sounding, c3) {
            None -> music {
                rest/4
            },
            Some(chosen) -> sound_for(chosen, 1/4),
        }
    }

    // Drop-2 from C4, a half long.
    fn drop_half(sounding: ChordClass) -> Music {
        match drop_position(sounding, c4, 2) {
            None -> music {
                rest/2
            },
            Some(chosen) -> sound_for(chosen, 1/2),
        }
    }

    // One stage of a walk, under a policy, at an index. The library answers
    // for one index as readily as for a count, which is what lets a score
    // place bars where it wants them.
    fn fifths_close(index: Nat) -> Music {
        stage_music(close_quarter, descending_fifths_chord(major, first, 3, index))
    }

    fn fifths_drop(index: Nat) -> Music {
        stage_music(drop_half, descending_fifths_chord(major, first, 3, index))
    }

    // The same pattern as seventh chords, which is how OMT 49 most often
    // prints it: the sevenths chain the resolutions together.
    fn sevenths_close(index: Nat) -> Music {
        stage_music(close_quarter, stacked_on(major, 4, descending_fifths_degree(first, index)))
    }

    // Descending thirds, the skeleton under the descending 5–6 pattern.
    fn thirds_close(index: Nat) -> Music {
        stage_music(close_quarter, stacked_on(major, 3, descending_thirds_degree(first, index)))
    }

    // Ascending seconds, in the natural minor collection, so that the same
    // index arithmetic produces a different succession of qualities without
    // being written a second time.
    fn seconds_minor(index: Nat) -> Music {
        stage_music(close_quarter, stacked_on(minor, 3, ascending_seconds_degree(first, index)))
    }

    score {
        // Descending fifths, eight stages: `I–IV–viiº–iii–vi–ii–V–I` in a major
        // collection. The diminished triad in it is the collection's doing.
        part fifths_triads {
            voice v {
                use fifths_close(0);
                use fifths_close(1);
                use fifths_close(2);
                use fifths_close(3);
                use fifths_close(4);
                use fifths_close(5);
                use fifths_close(6);
                use fifths_close(7);
            }
        }

        // The same eight stages, drop-2 and half notes. Same chords, and it
        // does not sound like the same music.
        part fifths_voiced_wider {
            voice v {
                use fifths_drop(0);
                use fifths_drop(1);
                use fifths_drop(2);
                use fifths_drop(3);
                use fifths_drop(4);
                use fifths_drop(5);
                use fifths_drop(6);
                use fifths_drop(7);
            }
        }

        // Four stages rather than eight: the count is a caller's decision and
        // stopping early is an ordinary thing to do.
        part fifths_sevenths {
            voice v {
                use sevenths_close(0);
                use sevenths_close(1);
                use sevenths_close(2);
                use sevenths_close(3);
            }
        }

        part descending_thirds_walk {
            voice v {
                use thirds_close(0);
                use thirds_close(1);
                use thirds_close(2);
                use thirds_close(3);
                use thirds_close(4);
                use thirds_close(5);
                use thirds_close(6);
                use thirds_close(7);
            }
        }

        // The one pattern read in another collection. `ascending_seconds_degree`
        // is the same function; `minor` is the only thing that changed.
        part ascending_seconds_in_minor {
            voice v {
                use seconds_minor(0);
                use seconds_minor(1);
                use seconds_minor(2);
                use seconds_minor(3);
                use seconds_minor(4);
                use seconds_minor(5);
                use seconds_minor(6);
                use seconds_minor(7);
            }
        }
    }
}
